<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Button Style -->
    <Style x:Key="PluginButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource RaisedPanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOffBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.4" />
                        <Border x:Name="ActiveGrooveGlow" Margin="-1" CornerRadius="10" Background="{DynamicResource LedYellowGreenBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource LedYellowGreen}" BlurRadius="5" ShadowDepth="0" Opacity="0.65" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="HoverGrooveGlow" Margin="-1" CornerRadius="10" Background="White" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0" />
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14" />
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.32" />
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.42" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}">
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.42" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.62" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.62" />
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource PanelBaseBrush}" />
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.04" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Body" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <!-- Keep a disabled active button based on the normal active
                             appearance. Otherwise the dimmed body reveals the
                             green active groove and makes the whole button green. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                            <Setter TargetName="Body" Property="Opacity" Value="1" />
                            <Setter Property="Opacity" Value="0.75" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsEnabled}" Value="False" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                            <Setter TargetName="Body" Property="Opacity" Value="1" />
                            <Setter Property="Opacity" Value="0.75" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ToggleButton Style -->
    <Style x:Key="PluginToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource RaisedPanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOffBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root">
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.4" />
                        <Border x:Name="ActiveGrooveGlow" Margin="-1" CornerRadius="10" Background="{DynamicResource LedYellowGreenBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource LedYellowGreen}" BlurRadius="5" ShadowDepth="0" Opacity="0.65" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="HoverGrooveGlow" Margin="-1" CornerRadius="10" Background="White" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0" />
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.42" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14" />
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.32" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.62" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource PanelBaseBrush}" />
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.04" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Body" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <!-- Keep a disabled checked toggle based on the normal
                             checked appearance instead of exposing the active
                             groove through a translucent body. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                            <Setter TargetName="Body" Property="Opacity" Value="1" />
                            <Setter Property="Opacity" Value="0.75" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left StepButton Style -->
    <Style x:Key="PluginLeftStepButtonStyle" TargetType="Button" BasedOn="{StaticResource PluginButtonStyle}">
        <Setter Property="Margin" Value="0,0,2.5,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Margin="-1" CornerRadius="10,0,0,10" Background="#FF000000" Opacity="0.4" />
                        <Border x:Name="HoverGrooveGlow" Margin="-1" CornerRadius="10,0,0,10" Background="White" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="9,0,0,9" BorderThickness="1,1,0,1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0" />
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="9,0,0,9" VerticalAlignment="Top" Height="8" Margin="1,1,0,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14" />
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.32" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource PanelBaseBrush}" />
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.04" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Body" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Right StepButton Style -->
    <Style x:Key="PluginRightStepButtonStyle" TargetType="Button" BasedOn="{StaticResource PluginButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Margin="0,-1,-1,-1" CornerRadius="0,10,10,0" Background="#FF000000" Opacity="0.4" />
                        <Border x:Name="HoverGrooveGlow" Margin="0,-1,-1,-1" CornerRadius="0,10,10,0" Background="White" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="0,9,9,0" BorderThickness="1,1,1,1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0" />
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="0,9,9,0" VerticalAlignment="Top" Height="8" Margin="0,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14" />
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.32" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource PanelBaseBrush}" />
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.04" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Body" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox Style -->
    <Style x:Key="PluginTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource RaisedPanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <GradientStop Color="#1EFFFFFF" Offset="0" />
                    <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="SelectionBrush" Value="{DynamicResource BgActiveBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <Border Margin="-1" CornerRadius="0" Background="#FF000000" Opacity="0.4" />
                        <Border x:Name="HoverGrooveGlow" Margin="-1" CornerRadius="0" Background="White" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.55" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Bd" CornerRadius="0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="0" VerticalAlignment="Bottom" Height="8" Margin="1,0,1,1" Opacity="0.06" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                            <GradientStop Color="White" Offset="0" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14" />
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.32" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="HoverGrooveGlow" Property="Background" Value="{DynamicResource LedYellowGreenBrush}" />
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.4" />
                            <Setter TargetName="HoverGrooveGlow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{DynamicResource LedYellowGreen}" BlurRadius="5" ShadowDepth="0" Opacity="0.65" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PluginNumericTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PluginTextBoxStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Right" />
    </Style>

    <!-- Search controls used by list tabs. Keep their dimensions and label
         treatment independent from each plugin's toolbar layout. -->
    <Style x:Key="PluginListSearchTextBoxStyle"
           TargetType="TextBox"
           BasedOn="{StaticResource PluginTextBoxStyle}">
        <Setter Property="Width" Value="140" />
        <Setter Property="AutomationProperties.Name" Value="一覧を検索" />
    </Style>

    <Style x:Key="PluginListSearchLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="12,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- CheckBox Style -->
    <Style x:Key="PluginCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                            <Border Margin="-1" CornerRadius="4" Background="#FF000000" Opacity="0.4" />
                            <Border x:Name="Glow" CornerRadius="3" Background="{DynamicResource LedYellowGreenBrush}" Opacity="0" />
                            <Border x:Name="Box" CornerRadius="3" Background="{DynamicResource PanelSurfaceBrush}" BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#1EFFFFFF" Offset="0" />
                                        <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <Path x:Name="CheckMark" Data="M 2.5,7 L 5.5,10 L 11.5,3.5" Stroke="{DynamicResource LedYellowGreenBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2" />
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Background" Value="White" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource PanelBaseBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Box" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton Style -->
    <Style x:Key="PluginRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Circle"
                                Width="16" Height="16"
                                Background="{DynamicResource ControlBaseBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,6,0">
                            <Ellipse x:Name="Dot"
                                     Width="8" Height="8"
                                     Fill="{DynamicResource TextActiveBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Circle" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider Style -->
    <Style x:Key="PluginSliderStyle" TargetType="Slider">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="Grid" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}" />
                        </Grid.RowDefinitions>
                        <Border x:Name="TrackBackground"
                                Height="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="ThumbVisual"
                                                     Fill="{DynamicResource TextSecondaryBrush}"
                                                     Stroke="{DynamicResource ControlBorderBrush}"
                                                     StrokeThickness="1" />
                                             <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbVisual" Property="Fill" Value="{DynamicResource BorderActiveBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbVisual" Property="Fill" Value="{DynamicResource BorderActiveBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBoxItem Style -->
    <Style x:Key="PluginComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBaseBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource LedYellowGreenBrush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBaseBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBaseBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox Style -->
    <Style x:Key="PluginComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource RaisedPanelBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1EFFFFFF" Offset="0" />
                    <GradientStop Color="#0FFFFFFF" Offset="0.5" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PluginComboBoxItemStyle}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.4" />
                                        <Border x:Name="ActiveGrooveGlow" Margin="-1" CornerRadius="10" Background="{DynamicResource LedYellowGreenBrush}" Opacity="0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="{DynamicResource LedYellowGreen}" BlurRadius="5" ShadowDepth="0" Opacity="0.65" />
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="HoverGrooveGlow" Margin="-1" CornerRadius="10" Background="White" Opacity="0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.55" />
                                            </Border.Effect>
                                        </Border>
                                        <Border x:Name="Border" CornerRadius="9" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                                            <Grid>
                                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="White" Offset="0" />
                                                            <GradientStop Color="Transparent" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <Path x:Name="Arrow" Fill="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Margin="4,0,6,0" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14" />
                                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.32" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.42" />
                                            <Setter TargetName="Gloss" Property="Opacity" Value="0.04" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsChecked" Value="True" />
                                                <Condition Property="IsMouseOver" Value="True" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0" />
                                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.62" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                           Margin="4,2,14,2"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource BgPopupBrush}"
                                    BorderBrush="{DynamicResource BorderOffBrush}"
                                    BorderThickness="1">
                                <ScrollViewer Margin="0" SnapsToDevicePixels="True">
                                    <ItemsPresenter SnapsToDevicePixels="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabItem Style -->
    <Style x:Key="PluginTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid x:Name="Root">
                        <Border x:Name="Border" Cursor="Hand" Background="{TemplateBinding Background}" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="{TemplateBinding Margin}">
                            <ContentPresenter x:Name="ContentSite" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource PluginTabHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextActiveBrush}"/>
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}"/>
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource PluginTabSelectedBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented RadioButton Option Style -->
    <Style x:Key="PluginSegmentedOptionStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PluginTabHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgActiveBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextActiveBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented Selector Container Style -->
    <Style x:Key="PluginSegmentedSelectorStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Height" Value="30" />
    </Style>

    <!-- TabControl Style -->
    <Style x:Key="PluginTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource RaisedPanelBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource PluginTabItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid SnapsToDevicePixels="true" KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource ControlBaseBrush}" BorderThickness="0">
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" Panel.ZIndex="1" Margin="0,0,0,-1" IsItemsHost="true" KeyboardNavigation.TabIndex="1"/>
                        </Border>
                        <Border x:Name="ContentPanel" Grid.Row="1" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="{StaticResource PluginOuterPanelBottomCornerRadius}" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                            <ContentPresenter x:Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PluginSettingsTabControlStyle"
           TargetType="TabControl"
           BasedOn="{StaticResource PluginTabControlStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ScrollViewer Style (Removes white corner box where scrollbars meet) -->
    <Style x:Key="PluginScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Grid.Row="0" Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                CanHorizontallyScroll="False"
                                                CanVerticallyScroll="False"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   Grid.Row="0" Grid.Column="1"
                                   AutomationProperties.AutomationId="VerticalScrollBar"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   Minimum="0"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   Value="{TemplateBinding VerticalOffset}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   Grid.Row="1" Grid.Column="0"
                                   AutomationProperties.AutomationId="HorizontalScrollBar"
                                   Cursor="Arrow"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   Minimum="0"
                                   Orientation="Horizontal"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                   Value="{TemplateBinding HorizontalOffset}" />
                        <Rectangle Grid.Row="1" Grid.Column="1" Fill="Transparent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PluginSettingsBodyStyle"
           TargetType="ScrollViewer"
           BasedOn="{StaticResource PluginScrollViewerStyle}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- ToolTip Style -->
    <Style x:Key="PluginToolTipStyle" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuItem Style -->
    <Style x:Key="PluginMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ContextMenu Style -->
    <Style x:Key="PluginContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ControlBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PluginMenuItemStyle}" />
    </Style>

    <!-- DataGrid Styles -->
    <Style x:Key="PluginDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource ControlBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="PluginDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource PanelBaseBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgActiveBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PluginDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PluginDataGridStyle" TargetType="DataGrid">
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource PluginDataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource PluginDataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource PluginDataGridCellStyle}" />
        <Setter Property="Background" Value="{DynamicResource PanelBaseBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <!-- Timeline presentation shared by protocol plugins. -->
    <Style x:Key="PluginTimelineBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="8,4,8,8" />
        <Setter Property="Padding" Value="1" />
        <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="PluginTimelineDataGridStyle" TargetType="DataGrid"
           BasedOn="{StaticResource PluginDataGridStyle}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ColumnHeaderHeight" Value="28" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
    </Style>

    <Style x:Key="PluginTimelineTimestampTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
    </Style>

    <Style x:Key="PluginTimelineTimestampCellStyle" TargetType="DataGridCell"
           BasedOn="{StaticResource PluginDataGridCellStyle}">
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="6,4,6,2" />
    </Style>

    <Style x:Key="PluginTimelineIdentityTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PluginDisplayAccentPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource MainFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Implicit Styles for Plugin Controls -->
    <Style TargetType="TabControl" BasedOn="{StaticResource PluginTabControlStyle}" />
    <Style TargetType="TabItem" BasedOn="{StaticResource PluginTabItemStyle}" />
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource PluginScrollViewerStyle}" />
    <Style TargetType="Button" BasedOn="{StaticResource PluginButtonStyle}" />
    <Style TargetType="ToggleButton" BasedOn="{StaticResource PluginToggleButtonStyle}" />
    <Style TargetType="TextBox" BasedOn="{StaticResource PluginTextBoxStyle}" />
    <Style TargetType="CheckBox" BasedOn="{StaticResource PluginCheckBoxStyle}" />
    <Style TargetType="RadioButton" BasedOn="{StaticResource PluginRadioButtonStyle}" />
    <Style TargetType="Slider" BasedOn="{StaticResource PluginSliderStyle}" />
    <Style TargetType="ComboBox" BasedOn="{StaticResource PluginComboBoxStyle}" />
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PluginComboBoxItemStyle}" />
    <Style TargetType="ToolTip" BasedOn="{StaticResource PluginToolTipStyle}" />
    <Style TargetType="ContextMenu" BasedOn="{StaticResource PluginContextMenuStyle}" />
    <Style TargetType="MenuItem" BasedOn="{StaticResource PluginMenuItemStyle}" />

</ResourceDictionary>
