<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:SRdeckPlugin.Wpf.Controls"
                    xmlns:contracts="clr-namespace:SRdeckPlugin.Contracts;assembly=SRdeckPlugin.Contracts">

    <!-- StatusBadge Style -->
    <Style TargetType="{x:Type controls:StatusBadge}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatusBadge}">
                    <Border x:Name="Bd"
                            Background="{DynamicResource PanelSurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot"
                                     Width="6" Height="6"
                                     Margin="0,0,5,0"
                                     Fill="{DynamicResource TextDimBrush}" />
                            <TextBlock x:Name="Txt"
                                       Text="{TemplateBinding StatusText}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       FontSize="{TemplateBinding FontSize}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="StatusKind" Value="{x:Static contracts:OverallStatusKind.Running}">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PluginStatusRunningBackgroundBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PluginStatusRunningBorderBrush}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PluginStatusRunningForegroundBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PluginStatusRunningForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="StatusKind" Value="{x:Static contracts:OverallStatusKind.Success}">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PluginStatusSuccessBackgroundBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PluginStatusSuccessBorderBrush}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PluginStatusSuccessForegroundBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PluginStatusSuccessForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="StatusKind" Value="{x:Static contracts:OverallStatusKind.Info}">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PluginStatusInfoBackgroundBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PluginStatusInfoBorderBrush}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PluginStatusInfoForegroundBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PluginStatusInfoForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="StatusKind" Value="{x:Static contracts:OverallStatusKind.Warning}">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PluginStatusWarningBackgroundBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PluginStatusWarningBorderBrush}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PluginStatusWarningForegroundBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PluginStatusWarningForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="StatusKind" Value="{x:Static contracts:OverallStatusKind.Error}">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PluginStatusErrorBackgroundBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PluginStatusErrorBorderBrush}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PluginStatusErrorForegroundBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PluginStatusErrorForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="StatusKind" Value="{x:Static contracts:OverallStatusKind.Critical}">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PluginStatusCriticalBackgroundBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PluginStatusCriticalBorderBrush}" />
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource PluginStatusCriticalForegroundBrush}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource PluginStatusCriticalForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact fixed summary used at the top of every plugin diagnostics tab. -->
    <Style TargetType="{x:Type controls:DiagnosticsOverview}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DiagnosticsOverview}">
                    <Border Background="{DynamicResource PanelSurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource PluginCardCornerRadius}"
                            Padding="10,7">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:StatusBadge
                                        StatusKind="{TemplateBinding EffectiveStatusKind}"
                                        StatusText="{TemplateBinding EffectiveStatusText}" />
                                    <TextBlock Text="{TemplateBinding PhaseText}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding LastUpdatedText}"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="10"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{TemplateBinding SummaryText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                            <TextBlock Text="{TemplateBinding RecommendationText}"
                                       Foreground="{DynamicResource TextDimBrush}"
                                       FontSize="10"
                                       TextWrapping="Wrap"
                                       Margin="0,1,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="{TemplateBinding RuntimeSummaryText}"
                                           ToolTip="{TemplateBinding RuntimeToolTipText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="10" />
                                <TextBlock Text=" ｜ "
                                           Foreground="{DynamicResource TextDimBrush}"
                                           FontSize="10" />
                                <TextBlock Text="{TemplateBinding ChannelText}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="10"
                                           MaxWidth="360"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{TemplateBinding ChannelText}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:RuntimeDiagnosticsDetails}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RuntimeDiagnosticsDetails}">
                    <Border Style="{DynamicResource PluginMetricCardStyle}" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="処理内容 / 実行先"
                                       Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding ProcessingStagesText}"
                                       ToolTip="{TemplateBinding ProcessingStagesToolTipText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />
                            <TextBlock Grid.Row="1" Text="リアルタイム処理負荷"
                                       Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{TemplateBinding LoadText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}" />
                            <TextBlock Grid.Row="2" Text="処理時間 / 入力時間枠"
                                       Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{TemplateBinding ProcessingText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}" />
                            <TextBlock Grid.Row="3" Text="処理待ち"
                                       Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       Text="{TemplateBinding QueueText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}" />
                            <TextBlock Grid.Row="4" Text="入力ドロップ"
                                       Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{TemplateBinding DropText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}" />
                            <TextBlock Grid.Row="5" Text="最終処理"
                                       Foreground="{DynamicResource TextDimBrush}" />
                            <TextBlock Grid.Row="5" Grid.Column="1"
                                       Text="{TemplateBinding LastProcessingText}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact status dot used by fixed headers. Bind Tag to OverallStatusKind. -->
    <Style x:Key="PluginStatusIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Fill" Value="{DynamicResource TextDimBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static contracts:OverallStatusKind.Running}">
                <Setter Property="Fill" Value="{DynamicResource PluginStatusRunningForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static contracts:OverallStatusKind.Success}">
                <Setter Property="Fill" Value="{DynamicResource PluginStatusSuccessForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static contracts:OverallStatusKind.Info}">
                <Setter Property="Fill" Value="{DynamicResource PluginStatusInfoForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static contracts:OverallStatusKind.Warning}">
                <Setter Property="Fill" Value="{DynamicResource PluginStatusWarningForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static contracts:OverallStatusKind.Error}">
                <Setter Property="Fill" Value="{DynamicResource PluginStatusErrorForegroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static contracts:OverallStatusKind.Critical}">
                <Setter Property="Fill" Value="{DynamicResource PluginStatusCriticalForegroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status Header Style -->
    <Style x:Key="PluginStatusHeaderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource PluginOuterPanelTopCornerRadius}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- Text hierarchy shared by fixed headers and content sections. -->
    <Style x:Key="PluginStatusHeaderTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Progressive-disclosure container for diagnostics below the fixed summary. -->
    <Style x:Key="PluginDiagnosticsSectionStyle" TargetType="Expander">
        <Setter Property="Background" Value="{DynamicResource PanelSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
