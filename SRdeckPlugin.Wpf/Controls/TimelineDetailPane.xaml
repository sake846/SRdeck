<UserControl x:Class="SRdeckPlugin.Wpf.Controls.TimelineDetailPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinHeight="96" MaxHeight="260" Margin="8,0,8,8"
             Foreground="{DynamicResource TextPrimaryBrush}"
             TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource PanelSurfaceBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1" CornerRadius="3" Padding="8,6"
            TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
        <Grid>
            <TextBlock Text="{Binding EmptyText, ElementName=Root}"
                       Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailContent, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetailContent, ElementName=Root}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ContentPresenter Content="{Binding DetailContent, ElementName=Root}"
                                  ContentTemplate="{Binding DetailContentTemplate, ElementName=Root}" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
