<Window x:Class="SRdeck.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SRdeck" Height="700" Width="1280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SRdeck;component/Resources/Fonts.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="1,0,1,1" SnapsToDevicePixels="True">
        <Grid>
            <Border CornerRadius="8"
                    BorderBrush="#4A9664"
                    BorderThickness="2"
                    Opacity="0.78"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <BlurEffect Radius="3.2"/>
                </Border.Effect>
            </Border>

            <Border Background="#0B1008" CornerRadius="8" BorderBrush="#4A9664" BorderThickness="2" SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#CC000000"/>
            </Border.Effect>
            <Grid Margin="1">
                <Border Background="#081006" CornerRadius="7" BorderThickness="0" ClipToBounds="True">
                    <Grid>
                        <!-- Web側と共通のプレミアム線画タイトル画像を表示 -->
                        <Image Source="pack://application:,,,/SRdeck;component/Resources/title_splash.png"
                               Stretch="UniformToFill"
                               SnapsToDevicePixels="True"/>

                        <!-- 角や辺のなじみを作って画像と枠線の消え際を揃える -->
                        <Border CornerRadius="7">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.92" RadiusY="0.92">
                                    <GradientStop Color="#00000000" Offset="0.74"/>
                                    <GradientStop Color="#18060B05" Offset="0.9"/>
                                    <GradientStop Color="#5A060B05" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>

                        <Rectangle VerticalAlignment="Top" Height="110" IsHitTestVisible="False">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#22000000" Offset="0"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <!-- 中央の画像タイトルロゴ（回路図枠内にジャストフィット） -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-22,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="16" Color="#00FF88" ShadowDepth="0" Opacity="0.4"/>
                                </Grid.Effect>
                                <Image Source="pack://application:,,,/SRdeck;component/Resources/srdeck_logo_trans.png"
                                       MaxHeight="185"
                                       MaxWidth="470"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"/>
                            </Grid>
                            <TextBlock x:Name="VersionInfoText"
                                       Grid.Row="1"
                                       Margin="0,6,0,0"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource MainFontFamily}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       Foreground="#8FE8A8">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="8" Color="#00FF88" ShadowDepth="0" Opacity="0.5"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>

                        <Border VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="40"
                                Padding="18,9"
                                MinWidth="520"
                                Background="#C0081006"
                                BorderBrush="#5A4A9664"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBlock x:Name="CalibrationStatusText"
                                       Text="Channel Auto: 起動準備中…"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontFamily="{StaticResource MainFontFamily}"
                                       FontSize="15"
                                       FontWeight="Medium"
                                       Foreground="#A9B6A6"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
