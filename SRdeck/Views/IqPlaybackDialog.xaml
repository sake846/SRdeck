<Window x:Class="SRdeck.Views.IqPlaybackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IQ WAV 再生" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow" ResizeMode="NoResize"
        Background="{DynamicResource PanelBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource MainFontFamily}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="保存した IQ WAV を再生します。中心周波数と開始位置を確認してください。"
                   TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Grid.Row="1" Text="ファイル" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilePath}" IsReadOnly="True"
                 Style="{DynamicResource PluginTextBoxStyle}" />
        <TextBlock Grid.Row="2" Text="形式" VerticalAlignment="Center" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FormatText}" Margin="4,6" />
        <TextBlock Grid.Row="3" Text="中心周波数 (MHz)" VerticalAlignment="Center" />
        <StackPanel Grid.Row="3" Grid.Column="1">
            <TextBox Text="{Binding CenterFrequencyMhz, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsCenterFrequencyEditable}"
                     Style="{DynamicResource PluginTextBoxStyle}" />
            <TextBlock Text="{Binding CenterFrequencyHint}" Foreground="{DynamicResource TextDimBrush}"
                       TextWrapping="Wrap" Margin="4,2,4,6" />
        </StackPanel>
        <TextBlock Grid.Row="4" Text="開始位置 (秒)" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding StartSeconds, UpdateSourceTrigger=PropertyChanged}"
                 Style="{DynamicResource PluginTextBoxStyle}" />
        <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding ErrorText}" Foreground="#FFFF6666" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,180,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" Width="80" Margin="4,0" Style="{DynamicResource PluginButtonStyle}"
                        IsCancel="True" />
                <Button Content="再生" Width="80" Margin="4,0" Style="{DynamicResource PluginButtonStyle}"
                        IsDefault="True" Click="Play_OnClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
