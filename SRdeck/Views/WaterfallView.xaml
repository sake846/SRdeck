<UserControl x:Class="SRdeck.Views.WaterfallView" x:Name="_waterfallViewRoot"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
               xmlns:localBehaviors="clr-namespace:SRdeck.Behaviors"
               mc:Ignorable="d" 
               d:DesignHeight="300" d:DesignWidth="1280"
               PreviewMouseMove="WaterfallView_PreviewMouseMove"
               MouseEnter="WaterfallView_MouseEnter">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="0" x:Name="gridWaterfallArea" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True" Background="Transparent">
        <Border x:Name="_interactionSurface" Margin="0,0,0,0" Background="Transparent" BorderBrush="#FF888888" BorderThickness="0" Focusable="True">
            <Grid Background="Transparent"
                  MouseDown="Border_MouseDown">
                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="MouseDown">
                        <localBehaviors:MouseEventToCommandBehavior Command="{Binding WaterfallMouseDownCommand}" CaptureMouseOnEvent="True" PassMouseButtonInfo="True" />
                    </b:EventTrigger>
                    <b:EventTrigger EventName="MouseUp">
                        <localBehaviors:MouseEventToCommandBehavior Command="{Binding WaterfallMouseUpCommand}" ReleaseMouseCaptureOnEvent="True" PassMouseButtonInfo="True" />
                    </b:EventTrigger>
                    <b:EventTrigger EventName="MouseLeave">
                        <b:InvokeCommandAction Command="{Binding MouseLeaveCommand}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Cursor" Value="Arrow" />
                    </Style>
                </Grid.Style>
                <Border Height="18" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Display.IsMainViewZoomed}" Value="True">
                                    <Setter Property="Background" Value="#FF606060" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Margin="0,18,0,0" BorderBrush="#FF888888" BorderThickness="1" SnapsToDevicePixels="True">
                    <Grid x:Name="gridWaterfallPlotArea" Margin="0">
                        <Image x:Name="_imgWaterfallBack" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                        
                        <!-- Interaction Area & Fore Image -->
                        <Border Margin="0" Background="Transparent" IsHitTestVisible="True" BorderThickness="0" Focusable="True">
                            <Image x:Name="_imgWaterfallFore" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor" SnapsToDevicePixels="True" />
                        </Border>



                        <Canvas x:Name="_canvasWaterfallOverlays" Margin="0" Panel.ZIndex="11" IsHitTestVisible="False" ClipToBounds="False">
                    <!-- Time/frequency annotations supplied by the active plugin. -->
                    <ItemsControl ItemsSource="{Binding WaterfallOverlay.Annotations}"
                                  Width="{Binding ActualWidth, ElementName=gridWaterfallPlotArea}"
                                  Height="{Binding ActualHeight, ElementName=gridWaterfallPlotArea}"
                                  ClipToBounds="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding ToolTip}" SnapsToDevicePixels="True">
                                    <Polygon Width="{Binding Width}" Height="{Binding Height}"
                                             Points="0,0 12,0 6,8" Fill="{Binding Color}"
                                             Stretch="Fill" SnapsToDevicePixels="True">
                                        <Polygon.Style>
                                            <Style TargetType="Polygon">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasLabel}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Polygon.Style>
                                    </Polygon>
                                    <Border Visibility="{Binding HasLabel, Converter={StaticResource BoolToVis}}"
                                            Height="16" Background="Transparent">
                                        <Border.LayoutTransform>
                                            <RotateTransform Angle="{Binding RotationDegrees}" />
                                        </Border.LayoutTransform>
                                        <TextBlock Text="{Binding Label}" Foreground="{Binding Color}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextOptions.TextFormattingMode="Display" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Waterfall X Labels -->
                    <ItemsControl ItemsSource="{Binding WaterfallOverlay.WaterfallXLabels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="-16" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Waterfall Y Labels -->
                    <ItemsControl ItemsSource="{Binding WaterfallOverlay.WaterfallYLabels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Canvas>
                                    <Line X1="0" Y1="{Binding YLine}" X2="5" Y2="{Binding YLine}" Stroke="#FF646464" StrokeThickness="1" />
                                    <Border Background="#40000000" CornerRadius="3" Canvas.Left="3" Canvas.Top="{Binding YLine}" Padding="2,2" Margin="0,-8,0,0">
                                        <TextBlock Text="{Binding TextLeft}" Width="18" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="11" />
                                    </Border>
                                    <Line X1="{Binding XRightLine1}" Y1="{Binding YLine}" X2="{Binding XRightLine2}" Y2="{Binding YLine}" Stroke="#FF646464" StrokeThickness="1" />
                                    <Border Background="#40000000" CornerRadius="3" Canvas.Left="{Binding XRightText}" Canvas.Top="{Binding YLine}" Padding="2,2" Margin="0,-8,0,0">
                                        <TextBlock Text="{Binding TextRight}" Width="18" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="11" />
                                    </Border>
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Diagnostics.WfInfoText}" Canvas.Left="50" Canvas.Top="25" Width="500" Foreground="#FFFF64FF" FontFamily="{StaticResource DisplayFontFamily}" FontSize="11" IsHitTestVisible="False" Visibility="{Binding Diagnostics.DebugTextVisible}" />
                    <TextBlock Text="{Binding Diagnostics.WfInfoTextRight}" Canvas.Left="550" Canvas.Top="25" Foreground="#FFFF64FF" FontFamily="{StaticResource DisplayFontFamily}" FontSize="11" TextAlignment="Left" IsHitTestVisible="False" Visibility="{Binding Diagnostics.DebugTextVisible}" />
                    <Line Stroke="#A0FFFFFF" StrokeThickness="1" X1="{Binding WaterfallOverlay.SpCsHotspotX}" Y1="-18" X2="{Binding WaterfallOverlay.SpCsHotspotX}" Y2="{Binding ActualHeight, ElementName=gridWaterfallPlotArea}" Visibility="{Binding WaterfallOverlay.SpCsVisible}" Opacity="{Binding WaterfallOverlay.SpCsOpacity}" />
                    <Line Stroke="#A0FFFFFF" StrokeThickness="1" X1="{Binding WaterfallOverlay.WfShortCsX1}" Y1="{Binding WaterfallOverlay.WfShortCsCenterY}" X2="{Binding WaterfallOverlay.WfShortCsX2}" Y2="{Binding WaterfallOverlay.WfShortCsCenterY}" Visibility="{Binding WaterfallOverlay.WfShortCsVisible}" Opacity="{Binding WaterfallOverlay.SpCsOpacity}" />
                    <Line Stroke="#A0FFFFFF" StrokeThickness="1" X1="{Binding WaterfallOverlay.WfShortCsCenterX}" Y1="{Binding WaterfallOverlay.WfShortCsY1}" X2="{Binding WaterfallOverlay.WfShortCsCenterX}" Y2="{Binding WaterfallOverlay.WfShortCsY2}" Visibility="{Binding WaterfallOverlay.WfShortCsVisible}" Opacity="{Binding WaterfallOverlay.SpCsOpacity}" />
                    <Line Stroke="#A0FFFFFF" StrokeThickness="1" X1="0" Y1="{Binding WaterfallOverlay.WfCsY}" X2="{Binding ActualWidth, ElementName=gridWaterfallPlotArea}" Y2="{Binding WaterfallOverlay.WfCsY}" Visibility="{Binding WaterfallOverlay.WfCsYVisible}" Opacity="{Binding WaterfallOverlay.SpCsOpacity}" />
                    <!-- クロスカーソル脇の周波数表示（背景透明化） -->
                    <Border Background="Transparent" Canvas.Left="{Binding WaterfallOverlay.WfCsTextX}" Canvas.Top="{Binding WaterfallOverlay.WfCsTextY}" Padding="4,2" CornerRadius="2" Visibility="{Binding WaterfallOverlay.WfCsYVisible}" Opacity="{Binding WaterfallOverlay.SpCsOpacity}">
                        <TextBlock Text="{Binding WaterfallOverlay.WfCsText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="{StaticResource DisplayFontFamily}" />
                    </Border>
                </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
