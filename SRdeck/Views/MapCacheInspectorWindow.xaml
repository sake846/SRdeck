<Window x:Class="SRdeck.Views.MapCacheInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:maps="clr-namespace:SRdeckPlugin.Wpf;assembly=SRdeckPlugin.Wpf"
        Title="{DynamicResource Title_MapCacheInspector}" Width="1180" Height="760" MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource PanelBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{DynamicResource MainFontFamily}"
        FontSize="10" UseLayoutRounding="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{DynamicResource PluginSettingsSectionStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,4">
                    <Button Content="{DynamicResource Btn_Close}" Style="{DynamicResource PluginButtonStyle}"
                            DockPanel.Dock="Right" MinWidth="80" Margin="12,0,0,0" Click="Close_Click" IsCancel="True" />
                    <TextBlock x:Name="SummaryText" Style="{DynamicResource PluginPrimarySectionHeaderStyle}"
                               VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,12,4">
                        <TextBlock Text="{DynamicResource Label_MapCacheTargetZoom}"
                                   Style="{DynamicResource PluginSettingsFieldLabelStyle}" Margin="0,0,8,0" />
                        <ComboBox x:Name="ZoomComboBox" Width="230" Style="{DynamicResource PluginComboBoxStyle}"
                                  AutomationProperties.Name="{DynamicResource Label_MapCacheTargetZoom}"
                                  SelectionChanged="ZoomComboBox_SelectionChanged" />
                    </StackPanel>
                    <ToggleButton x:Name="ExpiredOnlyToggleButton" Content="{DynamicResource Label_MapCacheExpiredOnly}"
                                  Style="{DynamicResource PluginToggleButtonStyle}" MinWidth="90" Margin="0,4,8,4"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    <Button Content="{DynamicResource Btn_MapCacheReloadList}" Style="{DynamicResource PluginButtonStyle}"
                            MinWidth="80" Click="ReloadList_Click" Margin="0,4,8,4" />
                    <Button x:Name="ShowSelectedButton" Content="{DynamicResource Btn_MapCacheShow}"
                            Style="{DynamicResource PluginButtonStyle}" MinWidth="100" Margin="0,4,0,4"
                            Click="ShowSelected_Click" IsEnabled="False" />
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                        <ToggleButton x:Name="DeleteModeToggleButton" Content="{DynamicResource Label_MapCacheDeleteMode}"
                                      Style="{DynamicResource PluginToggleButtonStyle}" MinWidth="90" Margin="0,0,8,0"
                                      Checked="DeleteMode_Changed" Unchecked="DeleteMode_Changed" />
                        <Button x:Name="DeleteSelectedButton" Content="{DynamicResource Btn_MapCacheDelete}"
                                Style="{DynamicResource PluginButtonStyle}" MinWidth="100"
                                Click="DeleteSelected_Click" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <ToggleButton x:Name="OnlineToggleButton" Content="{DynamicResource Label_MapCacheOnline}"
                                      Style="{DynamicResource PluginToggleButtonStyle}" Margin="0,0,8,0"
                                      Checked="Online_Changed" Unchecked="Online_Changed" />
                        <Button x:Name="RefreshVisibleButton" Content="{DynamicResource Btn_MapCacheRefreshVisible}"
                                Style="{DynamicResource PluginButtonStyle}"
                                Click="RefreshVisible_Click" IsEnabled="False" />
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{DynamicResource Desc_MapCacheInspector}"
                           Style="{DynamicResource PluginSettingsHintStyle}" />
                <TextBlock x:Name="DeleteModeHintText" Text="{DynamicResource Desc_MapCacheDeleteMode}"
                           Style="{DynamicResource PluginSettingsHintStyle}" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="7*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="160" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="5*" MinHeight="190" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="OverviewZoomText" Style="{DynamicResource PluginPrimarySectionHeaderStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Text="{DynamicResource Status_MapCacheLegend}"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <maps:GeoMapView x:Name="OverviewMap" Grid.Row="2" MapId="cache_inspector" />
                </Grid>
                <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource ControlBorderBrush}" />
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectionText" Style="{DynamicResource PluginSelectionDetailHeaderStyle}"
                               TextWrapping="Wrap" Margin="0,0,0,6" />
                    <DataGrid x:Name="TilesGrid" Grid.Row="1" Style="{DynamicResource PluginDataGridStyle}"
                              SelectionMode="Extended" EnableRowVirtualization="True" HeadersVisibility="Column"
                              SelectionChanged="TilesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource Column_MapCacheLocation}" Binding="{Binding Location}" Width="*" MinWidth="170" />
                            <DataGridTextColumn Header="X/Y" Binding="{Binding Coordinate}" Width="85" />
                            <DataGridTextColumn Header="{DynamicResource Column_MapCacheAge}" Binding="{Binding Age}" Width="50" />
                            <DataGridTextColumn Header="{DynamicResource Column_MapCacheExpiry}" Binding="{Binding Expiry}" Width="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock x:Name="NoTilesText" Grid.Row="1" Panel.ZIndex="1" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" />
                </Grid>
            </Grid>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource ControlBorderBrush}" />
            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailZoomText" Style="{DynamicResource PluginPrimarySectionHeaderStyle}"
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <maps:GeoMapView x:Name="DetailMap" Grid.Row="1" MapId="cache_inspector_detail" />
            </Grid>
        </Grid>
    </Grid>
</Window>
