<Window x:Class="SRdeck.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:SRdeck.Views.SettingsTabs"
        Title="{DynamicResource Title_Settings}" Width="620" Height="530"
        Background="#FF1E1E1E" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MainFontFamily}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Opacity="0" ContentRendered="Window_ContentRendered">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SRdeck;component/Resources/SettingsDialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Implicit Styles for this Window -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource SettingsCheckBoxStyle}" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource SettingsComboBoxStyle}" />
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource SettingsComboBoxItemStyle}" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12,4,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabs" Style="{StaticResource LocalTabControlStyle}" />

        <Button Grid.Row="1" Content="{DynamicResource Btn_Close}" Style="{StaticResource FlatButtonStyle}" Width="120" Height="28" Margin="0,4,0,2" HorizontalAlignment="Center" Click="CloseButton_Click" IsCancel="True" />

        <!-- Settings Reset Confirm Overlay (Red Warning Style) -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#CC151515" Visibility="{Binding SettingsResetConfirmVisibility}" Panel.ZIndex="1000" Margin="-12">
            <Border Background="#FF1E1E1E" BorderBrush="#FFFF5555" BorderThickness="1" CornerRadius="3"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="25" Margin="20">
                <StackPanel>
                    <TextBlock Text="{Binding SettingsResetConfirmTitle}" Foreground="#FFFF5555" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="{StaticResource MainFontFamily}" />
                    <TextBlock Text="{Binding SettingsResetConfirmMessage}" Foreground="White" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" FontFamily="{StaticResource MainFontFamily}" />
                    <Grid Margin="0,20,0,0" Width="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Btn_Yes}" Command="{Binding SettingsResetConfirmOkCommand}" Style="{StaticResource FlatButtonStyle}" Foreground="#FFFF5555" BorderBrush="#FFFF5555" Height="28" Cursor="Hand"/>
                        <Button Grid.Column="2" Content="{DynamicResource Btn_No}" Command="{Binding CloseSettingsResetConfirmCommand}" Style="{StaticResource FlatButtonStyle}" Height="28" Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
