<UserControl x:Class="SRdeck.Views.SettingsTabs.HackRfSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextPrimaryBrush}"
             FontFamily="{StaticResource MainFontFamily}">
    <StackPanel Margin="5,8">
        <Border Background="#FF151515" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <TextBlock Text="Sample rate" Foreground="#FF88CC00" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                <ComboBox Width="160" HorizontalAlignment="Left"
                          ItemsSource="{Binding SampleRateOptions}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding SdrPlaySampleRateHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsSampleRateSelectionEnabled}" />
            </StackPanel>
        </Border>

        <Border Background="#FF151515" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="4" Margin="0,0,0,10" Padding="12,10">
            <StackPanel>
                <TextBlock Text="GAIN" Foreground="#FF88CC00" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{Binding HackRfRfGainDb}" ContentStringFormat="{}{0} %"
                           FontSize="14" Foreground="White" FontWeight="Bold" Padding="0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButtonStyle}" Content="▼" Width="26" Height="26"
                                Command="{Binding ChangeHackRfGainCommand}" CommandParameter="-5" Margin="3,0" />
                        <Button Style="{StaticResource FlatButtonStyle}" Content="▲" Width="26" Height="26"
                                Command="{Binding ChangeHackRfGainCommand}" CommandParameter="5" Margin="3,0" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="LNA 0–40 dB / VGA 0–62 dB are mapped to this master gain."
                           Foreground="#FF8A8A8A" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <Border Background="#FF151515" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="4" Padding="12,10">
            <StackPanel>
                <TextBlock Text="Frequency correction (PPM)" Foreground="#FF88CC00" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBox Text="{Binding Tuner.TotalPpm, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"
                         Style="{StaticResource ReceiverDialogTextBoxStyle}" Width="78" Height="26"
                         HorizontalAlignment="Left" HorizontalContentAlignment="Right" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
