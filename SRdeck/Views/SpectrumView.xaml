<UserControl x:Class="SRdeck.Views.SpectrumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SRdeck.Views"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:localBehaviors="clr-namespace:SRdeck.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="800"
>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="0" x:Name="gridSpectrumArea" RenderOptions.EdgeMode="Aliased" SnapsToDevicePixels="True">
        <Border BorderBrush="#FF888888" BorderThickness="1" Margin="0">
            <Grid>
                <Image x:Name="_imgSpectrumBack" Stretch="Fill" Source="{Binding SpectrumBackgroundImage}" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />

                <!-- Interaction Area & Fore Image -->
                <Border x:Name="_interactionSurface" Margin="0" Background="Transparent" IsHitTestVisible="True" BorderThickness="0" Focusable="True" MouseDown="Border_MouseDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Style>
                    </Border.Style>
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDown">
                            <localBehaviors:MouseEventToCommandBehavior Command="{Binding SpectrumMouseDownCommand}" PassMouseButtonInfo="True" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="MouseUp">
                            <localBehaviors:MouseEventToCommandBehavior Command="{Binding SpectrumMouseUpCommand}" PassMouseButtonInfo="True" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="MouseMove">
                            <localBehaviors:MouseEventToCommandBehavior Command="{Binding SpectrumMouseMoveCommand}" />
                        </b:EventTrigger>
                        <b:EventTrigger EventName="MouseLeave">
                            <b:InvokeCommandAction Command="{Binding MouseLeaveCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <Image x:Name="_imgSpectrumFore" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" />
                </Border>



        <Canvas x:Name="_canvasSpectrumOverlays" IsHitTestVisible="False" ClipToBounds="True">
            <!-- Band Plan Overlay -->
            <!-- Band Plan Overlay - Background Rectangles -->
            <ItemsControl ItemsSource="{Binding SpectrumOverlay.BandPlanRegions}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Display.IsBandPlanVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Rectangle Fill="{Binding Color}" Canvas.Left="{Binding Left}" Width="{Binding Width}" Height="15" IsHitTestVisible="False" />
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Band Plan Overlay - Foreground Labels -->
            <ItemsControl ItemsSource="{Binding SpectrumOverlay.BandPlanRegions}">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Display.IsBandPlanVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Grid Canvas.Left="{Binding Left}" Canvas.Top="1" Width="{Binding Width}" IsHitTestVisible="False" ClipToBounds="False">
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="9" FontFamily="{StaticResource MainFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-200,0" />
                            </Grid>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Fill="#3CA07070" StrokeThickness="0" Canvas.Left="{Binding SpectrumOverlay.SpBand2Left}" Canvas.Top="0" Width="{Binding SpectrumOverlay.SpBand2Width}" Height="{Binding ActualHeight, ElementName=gridSpectrumArea}" Visibility="{Binding SpectrumOverlay.SpBand2Visible}" />
            <ItemsControl ItemsSource="{Binding SpectrumOverlay.ReceiverBands}"
                          Width="{Binding ActualWidth, ElementName=gridSpectrumArea}"
                          Height="{Binding ActualHeight, ElementName=gridSpectrumArea}"
                          IsHitTestVisible="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}" /><Setter Property="Canvas.Top" Value="{Binding Top}" /></Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding Width}" Height="{Binding Height}"
                                Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
                                BorderThickness="1,0,1,0" SnapsToDevicePixels="True">
                            <TextBlock Text="{Binding Label}" Foreground="{Binding LabelColor}"
                                       FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Rectangle Fill="#4800A0FF" StrokeThickness="0"
                       Canvas.Left="{Binding SpectrumOverlay.SpBandLeft}" Canvas.Top="0"
                       Width="{Binding SpectrumOverlay.SpBandWidth}"
                       Height="{Binding ActualHeight, ElementName=gridSpectrumArea}"
                       Visibility="{Binding SpectrumOverlay.SpBandVisible}" />
            <Rectangle Fill="#28FFFFFF" Canvas.Left="{Binding SpectrumOverlay.SpCsLeft}" Canvas.Top="0" Width="{Binding SpectrumOverlay.SpCsWidth}" Height="{Binding ActualHeight, ElementName=gridSpectrumArea}" Visibility="{Binding SpectrumOverlay.SpCsVisible}" Opacity="{Binding SpectrumOverlay.SpCsOpacity}" />
            <Line Stroke="#A0FFFFFF" StrokeThickness="1" X1="{Binding SpectrumOverlay.SpCsHotspotX}" Y1="0" X2="{Binding SpectrumOverlay.SpCsHotspotX}" Y2="{Binding ActualHeight, ElementName=gridSpectrumArea}" Visibility="{Binding SpectrumOverlay.SpCsVisible}" Opacity="{Binding SpectrumOverlay.SpCsOpacity}" />
            <Line Stroke="#A0FFFFFF" StrokeThickness="1" X1="0" Y1="{Binding SpectrumOverlay.SpCsDbY}" X2="{Binding ActualWidth, ElementName=gridSpectrumArea}" Y2="{Binding SpectrumOverlay.SpCsDbY}" Visibility="{Binding SpectrumOverlay.SpCsDbVisible}" Opacity="{Binding SpectrumOverlay.SpCsOpacity}" />
            <!-- クロスカーソル脇の周波数・レベル表示（背景透明で復旧） -->
            <Border Background="Transparent" Canvas.Left="{Binding SpectrumOverlay.SpCsTextX}" Canvas.Top="{Binding SpectrumOverlay.SpCsTextY}" Padding="4,2" CornerRadius="2" Visibility="{Binding SpectrumOverlay.SpCsDbVisible}" Opacity="{Binding SpectrumOverlay.SpCsOpacity}">
                <TextBlock Text="{Binding SpectrumOverlay.SpCsText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontFamily="{StaticResource DisplayFontFamily}" />
            </Border>
            <!-- カーソル周波数表示（左上）は非表示化 -->
            <Border Background="#96000000" Canvas.Left="50" Canvas.Top="24" Padding="2" CornerRadius="2" Visibility="Collapsed" Opacity="{Binding SpectrumOverlay.SpCsOpacity}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Cursor " Width="45" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MainFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" FontSize="11" />
                    <TextBlock Text="{Binding SpectrumOverlay.SpCursorFreqText}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource DisplayFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" FontSize="18" />
                    <TextBlock Text=" MHz" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MainFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Color Scale Bar -->
            <Rectangle Width="5" Height="{Binding SpectrumOverlay.SpColorBarHeight}" Fill="{Binding SpectrumOverlay.WaterfallColorScaleBrush}" Canvas.Left="{Binding SpectrumOverlay.SpColorBarLeft}" Canvas.Top="0" SnapsToDevicePixels="True" />

            <!-- Y-Axis Grid Labels -->
            <ItemsControl ItemsSource="{Binding SpectrumOverlay.SpectrumYLabels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <!-- Left side -->
                            <Border Background="#40000000" CornerRadius="3" Canvas.Left="1" Canvas.Top="{Binding Y}" Padding="2,2" Margin="0,-8,0,0">
                                <TextBlock Text="{Binding Text}" Width="24" TextAlignment="Right" Foreground="{Binding TextColor}" FontFamily="{StaticResource DisplayFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" FontSize="11" />
                            </Border>
                            <!-- Right side -->
                            <Border Background="#40000000" CornerRadius="3" Canvas.Left="{Binding XRight}" Canvas.Top="{Binding Y}" Padding="2,2" Margin="0,-8,0,0">
                                <TextBlock Text="{Binding Text}" Width="24" TextAlignment="Right" Foreground="{Binding TextColor}" FontFamily="{StaticResource DisplayFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" FontSize="11" />
                            </Border>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Station Labels -->
            <ItemsControl ItemsSource="{Binding SpectrumOverlay.StationLabels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Canvas>
                            <Border Background="#B0000000" CornerRadius="2" Padding="2,0">
                                <TextBlock Text="{Binding Name}" Foreground="{Binding Color}" FontSize="11" FontFamily="{StaticResource MainFontFamily}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" />
                            </Border>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Canvas>

            </Grid>
        </Border>
    </Grid>
</UserControl>
