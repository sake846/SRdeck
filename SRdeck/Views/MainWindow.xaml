<Window x:Class="SRdeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:localBehaviors="clr-namespace:SRdeck.Behaviors"
        xmlns:localViews="clr-namespace:SRdeck.Views"
        xmlns:models="clr-namespace:SRdeck.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:SRdeck.Converters"
        Title="{Binding WindowTitle}" Height="700" Width="1280" MinWidth="982"
        Background="{StaticResource PanelBaseBrush}" FontFamily="{StaticResource MainFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:LevelColorConverter x:Key="LevelColorConverter" />
        <conv:CpuColorConverter x:Key="CpuColorConverter" />
        <Style x:Key="OverflowTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Left" Command="{Binding ArrowKeyCommand}" CommandParameter="Left"/>
        <KeyBinding Key="Right" Command="{Binding ArrowKeyCommand}" CommandParameter="Right"/>
        <KeyBinding Key="Up" Command="{Binding ArrowKeyCommand}" CommandParameter="Up"/>
        <KeyBinding Key="Down" Command="{Binding ArrowKeyCommand}" CommandParameter="Down"/>
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftLeft"/>
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftRight"/>
        <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftUp"/>
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftDown"/>
        
        <!-- Global Hotkeys (Shift = Rx2) -->
        <KeyBinding Key="Q" Command="{Binding HotkeyCommand}" CommandParameter="Q1"/>
        <KeyBinding Key="Q" Modifiers="Shift" Command="{Binding HotkeyCommand}" CommandParameter="Q2"/>
        <KeyBinding Key="F" Command="{Binding HotkeyCommand}" CommandParameter="F1"/>
        <KeyBinding Key="F" Modifiers="Shift" Command="{Binding HotkeyCommand}" CommandParameter="F2"/>
        <KeyBinding Key="M" Command="{Binding HotkeyCommand}" CommandParameter="M1"/>
        <KeyBinding Key="M" Modifiers="Shift" Command="{Binding HotkeyCommand}" CommandParameter="M2"/>
        <KeyBinding Key="O" Command="{Binding HotkeyCommand}" CommandParameter="P1"/>
        <KeyBinding Key="O" Modifiers="Shift" Command="{Binding HotkeyCommand}" CommandParameter="P2"/>
        <KeyBinding Key="R" Command="{Binding HotkeyCommand}" CommandParameter="R1"/>
        <KeyBinding Key="R" Modifiers="Shift" Command="{Binding HotkeyCommand}" CommandParameter="R2"/>
        <KeyBinding Key="OemQuestion" Modifiers="Shift" Command="{Binding ToggleHelpCommand}"/>
        
        <KeyBinding Key="H" Command="{Binding ArrowKeyCommand}" CommandParameter="Left"/>
        <KeyBinding Key="J" Command="{Binding ArrowKeyCommand}" CommandParameter="Down"/>
        <KeyBinding Key="K" Command="{Binding ArrowKeyCommand}" CommandParameter="Up"/>
        <KeyBinding Key="L" Command="{Binding ArrowKeyCommand}" CommandParameter="Right"/>
        <KeyBinding Key="H" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftLeft"/>
        <KeyBinding Key="J" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftDown"/>
        <KeyBinding Key="K" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftUp"/>
        <KeyBinding Key="L" Modifiers="Shift" Command="{Binding ArrowKeyCommand}" CommandParameter="ShiftRight"/>
    </Window.InputBindings>
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="1,0,1,1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" /> <!-- Title Bar -->
                <RowDefinition Height="*" />  <!-- Main Content Area -->
                <RowDefinition Height="Auto" /> <!-- Bottom Controls Area -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <localViews:MainTitleBar Grid.Row="0" />

            <!-- Main Display Content -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.Resources>
                    <conv:StepColorConverter x:Key="StepColorConverter" />
                    <Style x:Key="RaisedPanelBorderStyle" TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FF3A3A3A" Offset="0" />
                                    <GradientStop Color="#FF2D2D2D" Offset="0.12" />
                                    <GradientStop Color="#FF202020" Offset="0.78" />
                                    <GradientStop Color="#FF111111" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FF6A6A6A" Offset="0" />
                                    <GradientStop Color="#FF3F3F3F" Offset="0.2" />
                                    <GradientStop Color="#FF111111" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderThickness" Value="1,1,2,2" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="ClipToBounds" Value="True" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="2" Direction="270" Opacity="0.55" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- Flat outer blocks are separated by a short lower shadow only:
                         no outline and no full-height gradient. -->
                    <Style x:Key="FlatRaisedPanelStyle" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource RaisedPanelBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="{StaticResource PluginOuterPanelCornerRadius}" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="4" Direction="270" Opacity="0.92" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="ReceiverControlPanelBorderStyle" TargetType="Border" BasedOn="{StaticResource FlatRaisedPanelStyle}" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />                    <!-- Spectrum and Waterfall -->
                    <RowDefinition Height="140" /> <!-- Start and Display Controls -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>

                <!-- Left: Spectrum and Waterfall -->
                <Border x:Name="_mainDisplayBorder" Grid.Row="0" Grid.Column="0"
                        Margin="6,6,0,6" Padding="8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource FlatRaisedPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Display.IsMainViewZoomed}" Value="True">
                                    <Setter Property="Background" Value="#FF606060" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid ClipToBounds="True">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseLeave">
                                <b:InvokeCommandAction Command="{Binding MouseLeaveCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MaxHeight="150" /> <!-- Spectrum Area (30%) -->
                            <RowDefinition Height="7*" />  <!-- Waterfall Area (Remaining 70%) -->
                        </Grid.RowDefinitions>

                        <localViews:SpectrumView Grid.Row="0" Margin="0" x:Name="_spectrumView">
                            <b:Interaction.Behaviors>
                                <localBehaviors:MouseWheelBehavior HorizontalDeltaCommand="{Binding SpectrumManipulationDeltaCommand}" HorizontalMultiplier="-1.0" CtrlVerticalDeltaCommand="{Binding MainViewZoomWheelCommand}" />
                            </b:Interaction.Behaviors>
                        </localViews:SpectrumView>

                        <localViews:WaterfallView Grid.Row="1" Margin="0,0,0,1"
                                                  VerticalAlignment="Stretch" ClipToBounds="True"
                                                  x:Name="_waterfallView">
                            <b:Interaction.Behaviors>
                                <localBehaviors:MouseWheelBehavior HorizontalDeltaCommand="{Binding WaterfallManipulationDeltaCommand}" HorizontalMultiplier="-1.0" VerticalDeltaCommand="{Binding WaterfallManipulationDeltaCommand}" VerticalMultiplier="-0.025" CtrlVerticalDeltaCommand="{Binding MainViewZoomWheelCommand}" />
                            </b:Interaction.Behaviors>
                        </localViews:WaterfallView>
                    </Grid>
                </Border>

                <!-- Right: active plugin workspace -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
                    <ContentControl Content="{Binding PluginWorkspace.ActiveContent}" />
                </Grid>

                <!-- Left: Start and display controls -->
                    <Grid Grid.Row="1" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ReceiverControlPanelBorderStyle}"
                                Height="134" VerticalAlignment="Top" Margin="6,0,0,6" Padding="0">
                        <StackPanel Orientation="Vertical">

                        <Grid VerticalAlignment="Top" Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Lower Left Grid: Play, MEM-1, Settings, Exit -->
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" Margin="6,0,5,0">
                                <!-- Section 1 -->
                                <Button x:Name="_btnStart" Style="{DynamicResource PluginButtonStyle}" Tag="{Binding SdrControl.IsStarted}" Width="60" Height="22" FontSize="10" Margin="3,4" Command="{Binding SdrControl.SdrToggleCommand}" IsEnabled="{Binding IsSdrToggleEnabled}" Focusable="False" IsTabStop="False">
                                    <Button.Content>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{DynamicResource Btn_Start}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SdrControl.StartButtonText}" Value="動作中">
                                                            <Setter Property="Text" Value="{DynamicResource Btn_Running}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SdrControl.StartButtonText}" Value="再生中">
                                                            <Setter Property="Text" Value="{DynamicResource Btn_PlayingWeb}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button.Content>
                                </Button>
                                <Button x:Name="_btnDetect" Style="{DynamicResource PluginButtonStyle}" Tag="{Binding IsSdrDetected}" Content="検出" Width="60" Height="22" FontSize="10" Margin="3,4" Command="{Binding DetectSdrCommand}" IsEnabled="{Binding IsStopped}" Focusable="False" IsTabStop="False" />
                                
                                <Button x:Name="_btnSettings" Style="{DynamicResource PluginButtonStyle}" Content="{DynamicResource Btn_Settings}" Width="60" Height="22" FontSize="10" Margin="3,4" Command="{Binding OpenSettingsDialogCommand}" Focusable="False" IsTabStop="False" />
                                <!-- Section 4 -->
                                <Button x:Name="_btnExit" Style="{DynamicResource PluginButtonStyle}" Tag="False" Content="{DynamicResource Btn_Exit}" Width="60" Height="22" FontSize="10" Margin="3,4" Command="{Binding ExitCommand}" Focusable="False" IsTabStop="False" />
                                </StackPanel>

                            <!-- Display Grid (Col 1: MODE, RATE, SP, WF) -->
                            <Grid Grid.Column="1" VerticalAlignment="Top" Margin="12,0,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /> <!-- Labels -->
                                    <ColumnDefinition Width="Auto" /> <!-- Controls -->
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- MODE -->
                                    <RowDefinition Height="Auto" /> <!-- RATE -->
                                    <RowDefinition Height="Auto" /> <!-- SP -->
                                    <RowDefinition Height="Auto" /> <!-- WF -->
                                </Grid.RowDefinitions>

                                <!-- Labels -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="MODE" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="10" Margin="3,4" Width="32" />
                                 <Button Grid.Row="2" Grid.Column="0" Command="{Binding Display.ResetSpectrumBiasCommand}" Width="22" Margin="3,4" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False">
                                     <Button.Template>
                                         <ControlTemplate TargetType="Button">
                                             <TextBlock Text="SP" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="10" Background="Transparent" />
                                         </ControlTemplate>
                                     </Button.Template>
                                 </Button>
                                 <Button Grid.Row="3" Grid.Column="0" Command="{Binding Display.ResetWaterfallBiasCommand}" Width="22" Margin="3,4" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False">
                                     <Button.Template>
                                         <ControlTemplate TargetType="Button">
                                             <TextBlock Text="WF" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="10" Background="Transparent" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="RATE" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="10" Margin="3,4" Width="32" />

                                 <!-- Controls -->
                                <ComboBox Grid.Row="0" Grid.Column="1" Width="112" Height="22" FontSize="10" Margin="3,4"
                                           ItemsSource="{Binding PluginWorkspace.Plugins}"
                                           DisplayMemberPath="Descriptor.DisplayName"
                                           SelectedValuePath="Descriptor.Id"
                                           SelectedValue="{Binding SelectedPluginId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           IsEnabled="{Binding IsPluginSelectionEnabled}"
                                           Focusable="False" IsTabStop="False"
                                           Style="{DynamicResource PluginComboBoxStyle}" />

                                 <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,4">
                                     <Button Style="{DynamicResource PluginLeftStepButtonStyle}" Content="▼" Width="27" Height="22" FontSize="10" Command="{Binding Display.AdjustSpectrumIntensityOffsetCommand}" CommandParameter="-10" Focusable="False" IsTabStop="False" />
                                     <Button Style="{DynamicResource PluginRightStepButtonStyle}" Content="▲" Width="27" Height="22" FontSize="10" Command="{Binding Display.AdjustSpectrumIntensityOffsetCommand}" CommandParameter="10" Focusable="False" IsTabStop="False" />
                                     <TextBlock Text="{Binding Display.SpectrumBiasAdj, StringFormat={}{0} dB}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                 </StackPanel>

                                 <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,4">
                                     <Button Style="{DynamicResource PluginLeftStepButtonStyle}" Content="・" Width="27" Height="22" FontSize="10" Command="{Binding Display.AdjustWaterfallIntensityOffsetCommand}" CommandParameter="-5" Focusable="False" IsTabStop="False" />
                                     <Button Style="{DynamicResource PluginRightStepButtonStyle}" Content="☀" Width="27" Height="22" FontSize="10" Command="{Binding Display.AdjustWaterfallIntensityOffsetCommand}" CommandParameter="5" Focusable="False" IsTabStop="False" />
                                    <TextBlock Text="{Binding Display.WaterfallBiasAdj}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontFamily="{StaticResource DisplayFontFamily}"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                 </StackPanel>

                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="_cmbSampleRate" Width="90" Height="22" FontSize="10" Margin="3,4" HorizontalAlignment="Left"
                                           SelectedValuePath="Tag"
                                           SelectedValue="{Binding SdrPlaySampleRateHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           IsEnabled="{Binding IsSampleRateSelectionEnabled}"
                                           Focusable="False" IsTabStop="False"
                                            Style="{DynamicResource PluginComboBoxStyle}">
                                    <ComboBoxItem Content="1.6 MS/s"><ComboBoxItem.Tag><sys:Int32>1600000</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                    <ComboBoxItem Content="2 MS/s"><ComboBoxItem.Tag><sys:Int32>2000000</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                    <ComboBoxItem Content="4 MS/s"><ComboBoxItem.Tag><sys:Int32>4000000</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                    <ComboBoxItem Content="6 MS/s"><ComboBoxItem.Tag><sys:Int32>6000000</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                    <ComboBoxItem Content="8 MS/s"><ComboBoxItem.Tag><sys:Int32>8000000</sys:Int32></ComboBoxItem.Tag></ComboBoxItem>
                                </ComboBox>
                            </Grid>

                        </Grid>
                        </StackPanel>
                    </Border>

                            <!-- SDR Settings Block (Col 2: right of SR, SP, WF, MODE controls) -->
                            <Border Grid.Column="2" Style="{StaticResource FlatRaisedPanelStyle}"
                                    Width="300" Height="134" Margin="6,0,0,6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Visibility="{Binding IsSdrSettingsVisible, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="24" />
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="0" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="SDR設定  " Foreground="#FF88CC00" FontWeight="Bold" FontSize="11" />
                                        <TextBlock Text="{Binding DeviceName}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                        <TextBlock Text="{Binding DeviceSn}" Foreground="#FFAAAAAA" FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0" />
                                    </StackPanel>

                                    <!-- 中心周波数表示 (sdrplayとrtlsdrの両方で表示、デバイス名称のすぐ下) -->
                                    <Grid Grid.Row="1" Margin="1,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="中心周波数" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Tuner.CenterFreqDisplay}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                    </Grid>

                                    <Grid Grid.Row="2" Margin="1,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="AGC" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="_btnAgc" Style="{DynamicResource PluginButtonStyle}" Tag="{Binding IsAgcEnabled}" Content="AGC" Width="60" Height="22" FontSize="10" Margin="0,0,6,0" Command="{Binding ToggleAgcCommand}" IsEnabled="{Binding IsSdrDetected}" Focusable="False" IsTabStop="False" />
                                            <ComboBox Width="110" Height="22" HorizontalAlignment="Left"
                                                      SelectedValuePath="Tag"
                                                      SelectedValue="{Binding AgcReleaseMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding IsSdrDetected}"
                                                      Style="{DynamicResource PluginComboBoxStyle}">
                                                 <ComboBoxItem Content="高速 (0.1秒)" Tag="{x:Static models:AgcReleaseMode.Fast}"/>
                                                <ComboBoxItem Content="中速 (1秒)" Tag="{x:Static models:AgcReleaseMode.Medium}"/>
                                                <ComboBoxItem Content="低速 (10秒)" Tag="{x:Static models:AgcReleaseMode.Slow}"/>
                                                <ComboBoxItem Content="アタックのみ" Tag="{x:Static models:AgcReleaseMode.AttackOnly}"/>
                                            </ComboBox>

                                        </StackPanel>
                                    </Grid>

                                    <!-- デバイス別ゲイン表示 -->
                                    <Grid Grid.Row="3">
                                        <!-- SDRplay: sensitivity changes the LNA/GR gain profile. -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRtlDevice}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="18"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="1,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="受信感度" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Style="{DynamicResource PluginSliderStyle}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Value="{Binding SdrPlaySensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="左: 強信号向け / 右: 微弱信号向け"
                                                        VerticalAlignment="Center" Margin="2,0,4,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SdrPlaySensitivity}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="1,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="状態" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SdrPlayGainSummary}" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>

                                        <!-- RTL-SDR: the same host AGC controls this normalized tuner gain. -->
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRtlDevice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24"/>
                                                <RowDefinition Height="18"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="1,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="26"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="RFゲイン" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <Slider Grid.Column="1" Style="{DynamicResource PluginSliderStyle}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                        Value="{Binding RtlSdrRfGainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        ToolTip="RTL-SDR チューナーの正規化ゲイン。AGCオン時は現在の自動ゲインを表示します。"
                                                        VerticalAlignment="Center" Margin="2,0,4,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding RtlSdrRfGainDb}" Foreground="White" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="1,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="状態" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RtlSdrGainSummary}" Foreground="White" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                        </Grid>

            </Grid>

            <!-- Overlays -->
            <localViews:MainOverlays Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
    </Border>
</Window>




