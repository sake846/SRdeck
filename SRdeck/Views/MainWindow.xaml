<Window x:Class="SRdeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:localBehaviors="clr-namespace:SRdeck.Behaviors"
        xmlns:localViews="clr-namespace:SRdeck.Views"
        xmlns:models="clr-namespace:SRdeck.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:SRdeck.Converters"
        Title="{Binding WindowTitle}" Height="700" Width="1280" MinWidth="982"
        Background="{StaticResource PanelBaseBrush}" FontFamily="{StaticResource MainFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:LevelColorConverter x:Key="LevelColorConverter" />
        <conv:CpuColorConverter x:Key="CpuColorConverter" />
        <Style x:Key="OverflowTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
    </Window.Resources>
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Margin" Value="1,0,1,1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                        <Setter Property="Margin" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" /> <!-- Title Bar -->
                <RowDefinition Height="*" />  <!-- Main Content Area -->
                <RowDefinition Height="Auto" /> <!-- Bottom Controls Area -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <localViews:MainTitleBar Grid.Row="0" />

            <!-- Main Display Content -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.Resources>
                    <conv:StepColorConverter x:Key="StepColorConverter" />
                    <Style x:Key="RaisedPanelBorderStyle" TargetType="Border">
                        <Setter Property="Background">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FF3A3A3A" Offset="0" />
                                    <GradientStop Color="#FF2D2D2D" Offset="0.12" />
                                    <GradientStop Color="#FF202020" Offset="0.78" />
                                    <GradientStop Color="#FF111111" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderBrush">
                            <Setter.Value>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#FF6A6A6A" Offset="0" />
                                    <GradientStop Color="#FF3F3F3F" Offset="0.2" />
                                    <GradientStop Color="#FF111111" Offset="1" />
                                </LinearGradientBrush>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderThickness" Value="1,1,2,2" />
                        <Setter Property="CornerRadius" Value="4" />
                        <Setter Property="ClipToBounds" Value="True" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="2" Direction="270" Opacity="0.55" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- Flat outer blocks are separated by a short lower shadow only:
                         no outline and no full-height gradient. -->
                    <Style x:Key="FlatRaisedPanelStyle" TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource RaisedPanelBrush}" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="{StaticResource PluginOuterPanelCornerRadius}" />
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="Effect">
                            <Setter.Value>
                                <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="4" Direction="270" Opacity="0.92" />
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="ReceiverControlPanelBorderStyle" TargetType="Border" BasedOn="{StaticResource FlatRaisedPanelStyle}" />
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="700" />
                </Grid.ColumnDefinitions>

                <!-- Left: Spectrum and Waterfall -->
                <Border x:Name="_mainDisplayBorder" Grid.Column="0"
                        Margin="6,6,0,6" Padding="8">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource FlatRaisedPanelStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Display.IsMainViewZoomed}" Value="True">
                                    <Setter Property="Background" Value="#FF606060" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid ClipToBounds="True">
                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="MouseLeave">
                                <b:InvokeCommandAction Command="{Binding MouseLeaveCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MaxHeight="150" /> <!-- Spectrum Area (30%) -->
                            <RowDefinition Height="7*" />  <!-- Waterfall Area (Remaining 70%) -->
                        </Grid.RowDefinitions>

                        <localViews:SpectrumView Grid.Row="0" Margin="0" x:Name="_spectrumView">
                            <b:Interaction.Behaviors>
                                <localBehaviors:MouseWheelBehavior HorizontalDeltaCommand="{Binding SpectrumManipulationDeltaCommand}" HorizontalMultiplier="-1.0" VerticalDeltaCommand="{Binding SpectrumWheelCommand}" CtrlVerticalDeltaCommand="{Binding MainViewZoomWheelCommand}" />
                            </b:Interaction.Behaviors>
                        </localViews:SpectrumView>

                        <localViews:WaterfallView Grid.Row="1" Margin="0,0,0,1"
                                                  VerticalAlignment="Stretch" ClipToBounds="True"
                                                  x:Name="_waterfallView">
                            <b:Interaction.Behaviors>
                                <localBehaviors:MouseWheelBehavior HorizontalDeltaCommand="{Binding WaterfallManipulationDeltaCommand}" HorizontalMultiplier="-1.0" VerticalDeltaCommand="{Binding WaterfallWheelCommand}" CtrlVerticalDeltaCommand="{Binding MainViewZoomWheelCommand}" />
                            </b:Interaction.Behaviors>
                        </localViews:WaterfallView>
                    </Grid>
                </Border>

                <!-- Right: Top controls & active plugin workspace -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Controls Block (Start/MODE/RATE/SP/WF + SDR Settings) -->
                    <Grid Grid.Row="0" Margin="6,6,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Start and Display Controls -->
                        <Border Grid.Column="0" Style="{StaticResource ReceiverControlPanelBorderStyle}"
                                Height="136" VerticalAlignment="Top" Margin="0" Padding="0">
                            <Grid VerticalAlignment="Center" Margin="0,6,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Lower Left Grid: Play, MEM-1, Settings, Exit -->
                                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top" Margin="4,0,0,0">
                                    <!-- Section 1 -->
                                    <Button x:Name="_btnStart" Style="{DynamicResource PluginButtonStyle}" Tag="{Binding SdrControl.IsStarted}" Width="58" Margin="3,4" Command="{Binding SdrControl.SdrToggleCommand}" IsEnabled="{Binding IsSdrToggleEnabled}" Focusable="False" IsTabStop="False">
                                        <Button.Content>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{DynamicResource Btn_Start}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SdrControl.StartButtonText}" Value="動作中">
                                                                <Setter Property="Text" Value="{DynamicResource Btn_Running}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SdrControl.StartButtonText}" Value="再生中">
                                                                <Setter Property="Text" Value="{DynamicResource Btn_PlayingWeb}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.Content>
                                    </Button>
                                    <Button x:Name="_btnDetect" Style="{DynamicResource PluginButtonStyle}" Tag="{Binding IsSdrDetected}" Content="検出" Width="58" Margin="3,4" Command="{Binding DetectSdrCommand}" IsEnabled="{Binding IsStopped}" Focusable="False" IsTabStop="False" />
                                    
                                    <Button x:Name="_btnSettings" Style="{DynamicResource PluginButtonStyle}" Content="{DynamicResource Btn_Settings}" Width="58" Margin="3,4" Command="{Binding OpenSettingsDialogCommand}" Focusable="False" IsTabStop="False" />
                                    <!-- Section 4 -->
                                    <Button x:Name="_btnExit" Style="{DynamicResource PluginButtonStyle}" Tag="False" Content="{DynamicResource Btn_Exit}" Width="58" Margin="3,4" Command="{Binding ExitCommand}" Focusable="False" IsTabStop="False" />
                                </StackPanel>

                                <!-- Display Grid (Col 1: 表示幅, 波形位置, 描画輝度, 描画速度) -->
                                <Grid Grid.Column="1" VerticalAlignment="Top" Margin="16,0,4,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /> <!-- Labels -->
                                         <ColumnDefinition Width="Auto" /> <!-- Controls -->
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- 表示幅 -->
                                        <RowDefinition Height="Auto" /> <!-- 波形位置 -->
                                        <RowDefinition Height="Auto" /> <!-- 描画輝度 -->
                                        <RowDefinition Height="Auto" /> <!-- 描画速度 -->
                                    </Grid.RowDefinitions>

                                    <!-- Labels -->
                                    <Button Grid.Row="0" Grid.Column="0" Command="{Binding Display.ResetMainSpanCommand}" Width="46" Margin="1,4" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="全帯域（フルスパン）にリセット">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="表示幅" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MainFontFamily}" VerticalAlignment="Center" FontSize="11" Background="Transparent" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="0" Command="{Binding Display.ResetSpectrumBiasCommand}" Width="46" Margin="1,4" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="波形位置をリセット">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="波形位置" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MainFontFamily}" VerticalAlignment="Center" FontSize="11" Background="Transparent" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Row="2" Grid.Column="0" Command="{Binding Display.ResetWaterfallBiasCommand}" Width="46" Margin="1,4" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="描画輝度をリセット">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="描画輝度" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MainFontFamily}" VerticalAlignment="Center" FontSize="11" Background="Transparent" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Row="3" Grid.Column="0" Command="{Binding ResetWaterfallTimeModeCommand}" Width="46" Margin="1,4" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="描画速度をリセット（3 分）">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="描画速度" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource MainFontFamily}" VerticalAlignment="Center" FontSize="11" Background="Transparent" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <!-- Controls -->
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,4">
                                        <Slider Width="104" Style="{DynamicResource PluginSliderStyle}"
                                                Minimum="0" Maximum="100"
                                                SmallChange="5" LargeChange="10"
                                                Value="{Binding Display.MainSpanSliderPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding Display.CurrentMainSpanText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,4">
                                        <Slider Width="104" Style="{DynamicResource PluginSliderStyle}"
                                                Minimum="-100" Maximum="100"
                                                TickFrequency="10" IsSnapToTickEnabled="True"
                                                SmallChange="10" LargeChange="10"
                                                Value="{Binding Display.SpectrumBiasSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding Display.SpectrumBiasAdj, StringFormat={}{0} dB}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,4">
                                        <Slider Width="104" Style="{DynamicResource PluginSliderStyle}"
                                                Minimum="-100" Maximum="100"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                SmallChange="5" LargeChange="5"
                                                Value="{Binding Display.WaterfallBiasSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding Display.WaterfallBiasAdj}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,4">
                                        <Slider Width="104" Style="{DynamicResource PluginSliderStyle}"
                                                Minimum="0" Maximum="4"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="1"
                                                Value="{Binding WaterfallDisplayTimeModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                VerticalAlignment="Center" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding WaterfallDisplayTimeModeText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- SDR Settings Block -->
                        <Border Grid.Column="2" Style="{StaticResource FlatRaisedPanelStyle}"
                                Height="136" Margin="0" Padding="8,6" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                Visibility="{Binding IsSdrSettingsVisible, Converter={StaticResource BoolToVis}}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: SDR 5 Rows -->
                                <Grid Grid.Column="0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Row 0: Device Info -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DeviceName}" Foreground="#FF88CC00" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,3,8,3" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceSn}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="11" VerticalAlignment="Center" Margin="0,3,0,3" />

                                    <!-- Row 1: Sample Rate -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="サンプリング" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,3,8,3" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                                        <ComboBox x:Name="_cmbSampleRate" Width="95" HorizontalAlignment="Left"
                                                   ItemsSource="{Binding SampleRateOptions}"
                                                   DisplayMemberPath="Label"
                                                   SelectedValuePath="Value"
                                                   SelectedValue="{Binding SdrPlaySampleRateHz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                   IsEnabled="{Binding IsSampleRateSelectionEnabled}"
                                                   Focusable="False" IsTabStop="False"
                                                   Style="{DynamicResource PluginComboBoxStyle}">
                                        </ComboBox>
                                        <TextBlock Text="{Binding EffectiveBitDepthText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="{StaticResource DisplayFontFamily}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>

                                    <!-- Row 2: Center Frequency -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="中心周波数" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,3,8,3" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Tuner.CenterFreqDisplay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Normal" FontFamily="{StaticResource MainFontFamily}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,3,0,3"/>

                                    <!-- Row 3: Sensitivity Control (AGC Mode) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="感度制御" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,3,8,3" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Width="110" HorizontalAlignment="Left" Margin="0,3,0,3"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding AgcReleaseMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsSdrDetected}"
                                              Focusable="False" IsTabStop="False"
                                              Style="{DynamicResource PluginComboBoxStyle}">
                                        <ComboBoxItem Content="制御なし" Tag="{x:Static models:AgcReleaseMode.Off}"/>
                                        <ComboBoxItem Content="高速 (0.1秒)" Tag="{x:Static models:AgcReleaseMode.Fast}"/>
                                        <ComboBoxItem Content="中速 (1秒)" Tag="{x:Static models:AgcReleaseMode.Medium}"/>
                                        <ComboBoxItem Content="低速 (10秒)" Tag="{x:Static models:AgcReleaseMode.Slow}"/>
                                        <ComboBoxItem Content="アタックのみ" Tag="{x:Static models:AgcReleaseMode.AttackOnly}"/>
                                    </ComboBox>

                                    <!-- Row 4: Sensitivity / Gain Slider -->
                                    <!-- SDRplay: Sensitivity Label -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="受信感度" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,3,8,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRtlDevice}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- RTL-SDR: RF Gain Label -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="RFゲイン" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,3,8,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRtlDevice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- SDRplay Slider Controls (Row 4, Col 1) -->
                                    <Grid Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRtlDevice}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{DynamicResource PluginSliderStyle}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding SdrPlaySensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="左: 強信号向け / 右: 微弱信号向け"
                                                VerticalAlignment="Center" Margin="2,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SdrPlayMaxGainRatioText}" ToolTip="{Binding SdrPlayLnaGrText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Normal" FontFamily="{StaticResource DisplayFontFamily}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- RTL-SDR Slider Controls (Row 4, Col 1) -->
                                    <Grid Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,3,0,3">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRtlDevice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Style="{DynamicResource PluginSliderStyle}" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding RtlSdrRfGainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="RTL-SDR チューナーの正規化ゲイン。AGCオン時は現在の自動ゲインを表示します。"
                                                VerticalAlignment="Center" Margin="2,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RtlSdrRfGainDb}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="Normal" FontFamily="{StaticResource DisplayFontFamily}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>

                                <!-- Right Column: IQ Level Meter (Vertical, bottom-to-top) -->
                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,2,0" ToolTip="{Binding Diagnostics.IqToolTip}">
                                    <TextBlock Text="IQ" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="10pt" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                    <Border BorderBrush="#FF888888" BorderThickness="1" Background="Transparent" HorizontalAlignment="Center">
                                        <Grid Width="80" Height="21" HorizontalAlignment="Left" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                            <Grid.LayoutTransform>
                                                <RotateTransform Angle="-90" />
                                            </Grid.LayoutTransform>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="1" />
                                                <RowDefinition Height="10" />
                                            </Grid.RowDefinitions>
                                            <!-- Invalid Bits Background (Gray fill for bits below device ADC resolution) -->
                                            <Rectangle Grid.Row="0" Grid.RowSpan="3"
                                                       Width="{Binding Diagnostics.InvalidBitsWidth}"
                                                       Height="21"
                                                       Fill="#FF383838"
                                                       HorizontalAlignment="Left" />
                                            <!-- I Channel (10px) -->
                                            <Rectangle Grid.Row="0"
                                                       Width="{Binding Diagnostics.InputLevelI}"
                                                       Height="10"
                                                       Fill="{Binding Diagnostics.InputLevelIDb, Converter={StaticResource LevelColorConverter}}"
                                                       HorizontalAlignment="Left" />
                                            <!-- Center Divider (1px) -->
                                            <Rectangle Grid.Row="1"
                                                       Width="80"
                                                       Height="1"
                                                       Fill="#FF888888"
                                                       HorizontalAlignment="Left" />
                                            <!-- Q Channel (10px) -->
                                            <Rectangle Grid.Row="2"
                                                       Width="{Binding Diagnostics.InputLevelQ}"
                                                       Height="10"
                                                       Fill="{Binding Diagnostics.InputLevelQDb, Converter={StaticResource LevelColorConverter}}"
                                                       HorizontalAlignment="Left" />
                                            <!-- Invalid Bits Overlay (Mutes signal bars in invalid bit zone) -->
                                            <Rectangle Grid.Row="0" Grid.RowSpan="3"
                                                       Width="{Binding Diagnostics.InvalidBitsWidth}"
                                                       Height="21"
                                                       Fill="#80282828"
                                                       HorizontalAlignment="Left" />
                                            <!-- Grid Lines (16 bits) -->
