<UserControl x:Class="SRdeck.Views.MainTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:SRdeck.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="1280">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:LevelColorConverter x:Key="LevelColorConverter" />
        <conv:CpuColorConverter x:Key="CpuColorConverter" />
    </UserControl.Resources>
    
    <Grid Background="{StaticResource PanelSurfaceBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" /> <!-- Column 0: Title & Device Info (Left) -->
            <ColumnDefinition Width="*" />    <!-- Column 1: Flexible Space (Center) -->
            <ColumnDefinition Width="Auto" /> <!-- Column 2: Status Meters (IQ, PRC) -->
            <ColumnDefinition Width="Auto" /> <!-- Column 3: System Buttons (Minimize, Maximize, Close - Rightmost) -->
        </Grid.ColumnDefinitions>

        <!-- Left Content: App Title -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
            <Image Source="/SRdeck.ico" Width="16" Height="16" Margin="0,0,10,0" />
            <TextBlock Text="SRdeck" 
                       Foreground="White" 
                       FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                       FontSize="{Binding Source={x:Static SystemFonts.CaptionFontSize}}"
                       FontWeight="{Binding Source={x:Static SystemFonts.CaptionFontWeight}}"
                       VerticalAlignment="Center" Margin="0,1,0,0" />
        </StackPanel>

        <!-- Column 2: IQ & PRC Status Meters (Pushes left gracefully when resized smaller) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsStarted, Converter={StaticResource BoolToVis}}">


                <!-- RTL-SDR: show GAIN only -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRtlDevice}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="GAIN"
                               Foreground="White"
                               FontSize="10"
                               FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                               VerticalAlignment="Center"
                               Margin="0,0,1,0" />
                    <TextBlock Text="{Binding RfGainDb, StringFormat={}{0:#0}}"
                               Width="16"
                               TextAlignment="Right"
                               Foreground="#FFB4E632"
                               FontSize="10"
                               FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                               VerticalAlignment="Center" />
                    <TextBlock Text=""
                               Foreground="White"
                               FontSize="10"
                               FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="IQ" Foreground="White" FontSize="10" FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Border Width="82" Height="16" BorderBrush="#FF888888" BorderThickness="1" Background="Transparent" VerticalAlignment="Center" ToolTip="{Binding Diagnostics.IqToolTip}">
                    <Grid Width="80" Height="14" HorizontalAlignment="Left" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="7" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <!-- Invalid Bits Background (Gray fill for bits below device ADC resolution) -->
                        <Rectangle Grid.RowSpan="2"
                                   Width="{Binding Diagnostics.InvalidBitsWidth}"
                                   Height="14"
                                   Fill="#FF383838"
                                   HorizontalAlignment="Left" />
                        <Rectangle Grid.Row="0"
                                   Width="{Binding Diagnostics.InputLevelI}"
                                   Height="7"
                                   Fill="{Binding Diagnostics.InputLevelIDb, Converter={StaticResource LevelColorConverter}}"
                                   HorizontalAlignment="Left" />
                        <Rectangle Grid.Row="1"
                                   Width="{Binding Diagnostics.InputLevelQ}"
                                   Height="7"
                                   Fill="{Binding Diagnostics.InputLevelQDb, Converter={StaticResource LevelColorConverter}}"
                                   HorizontalAlignment="Left" />
                        <!-- Invalid Bits Overlay (Mutes signal bars in invalid bit zone) -->
                        <Rectangle Grid.RowSpan="2"
                                   Width="{Binding Diagnostics.InvalidBitsWidth}"
                                   Height="14"
                                   Fill="#80282828"
                                   HorizontalAlignment="Left" />
                        <Grid Grid.RowSpan="2" Width="80" Height="14" HorizontalAlignment="Left" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7" />
                                <RowDefinition Height="7" />
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="1" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="2" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="3" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="4" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="5" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="6" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="7" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="8" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="9" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="10" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="11" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="12" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="13" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="14" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Row="0" Grid.ColumnSpan="16" BorderBrush="#FF888888" BorderThickness="0,0,0,1" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" Visibility="{Binding IsAnySourceActive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="PRC" Foreground="White" FontSize="10" FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Border Width="102" Height="16" BorderBrush="#FF888888" BorderThickness="1" Background="Transparent" VerticalAlignment="Center">
                    <Grid Width="100" Height="14" HorizontalAlignment="Left" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="7" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <Rectangle Grid.Row="0"
                                   Width="{Binding Diagnostics.CoreProcessingLoad}"
                                   Height="7"
                                   Fill="{Binding Diagnostics.CoreProcessingLoad, Converter={StaticResource CpuColorConverter}}"
                                   HorizontalAlignment="Left" />
                        <Rectangle Grid.Row="1"
                                   Width="{Binding Diagnostics.PluginProcessingLoad}"
                                   Height="7"
                                   Fill="{Binding Diagnostics.PluginProcessingLoad, Converter={StaticResource CpuColorConverter}}"
                                   HorizontalAlignment="Left" />
                        <Grid Grid.RowSpan="2" Width="100" Height="14" HorizontalAlignment="Left" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="25" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="7" />
                                <RowDefinition Height="7" />
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="1" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Column="2" Grid.RowSpan="2" BorderBrush="#FF888888" BorderThickness="0,0,1,0" />
                            <Border Grid.Row="0" Grid.ColumnSpan="4" BorderBrush="#FF888888" BorderThickness="0,0,0,1" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" ToolTip="App / Total" Visibility="{Binding IsAnySourceActive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="GPU" Foreground="White" FontSize="10" FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}" VerticalAlignment="Center" Margin="0,0,1,0" />
                <TextBlock Text="{Binding Diagnostics.GpuAppUsagePercent, StringFormat={}{0:#0}}"
                           Width="20"
                           TextAlignment="Right"
                           Foreground="{Binding Diagnostics.GpuAppUsagePercent, Converter={StaticResource CpuColorConverter}, ConverterParameter=Solid}"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center" />
                <TextBlock Text="/"
                           Foreground="White"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding Diagnostics.GpuUsagePercent, StringFormat={}{0:#0}}"
                           Width="20"
                           TextAlignment="Right"
                           Foreground="{Binding Diagnostics.GpuUsagePercent, Converter={StaticResource CpuColorConverter}, ConverterParameter=Solid}"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center" />
                <TextBlock Text="%"
                           Foreground="White"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="12,1,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsAnySourceActive, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="FFT"
                           Foreground="White"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center"
                           Margin="0,0,1,0" />
                <TextBlock Text="{Binding Diagnostics.FftFps, StringFormat={}{0:#0}}"
                           Width="16"
                           TextAlignment="Right"
                           Foreground="#FFB4E632"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center" />
                <TextBlock Text="fps   WPF"
                           Foreground="White"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center"
                           Margin="1,0,1,0" />
                <TextBlock Text="{Binding Diagnostics.WpfFps, StringFormat={}{0:#0}}"
                           Width="16"
                           TextAlignment="Right"
                           Foreground="#FFB4E632"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center" />
                <TextBlock Text="fps"
                           Foreground="White"
                           FontSize="10"
                           FontFamily="{Binding Source={x:Static SystemFonts.CaptionFontFamily}}"
                           VerticalAlignment="Center"
                           Margin="1,0,1,0" />
            </StackPanel>

        </StackPanel>

        <!-- Column 3: Window Chrome System Buttons (Guaranteed to align to the absolute right) -->
        <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click">
                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click">
                <TextBlock x:Name="MaximizeIcon" FontFamily="Segoe MDL2 Assets" FontSize="10" 
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE922;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowState}" Value="Maximized">
                                    <Setter Property="Text" Value="&#xE923;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>
            <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
