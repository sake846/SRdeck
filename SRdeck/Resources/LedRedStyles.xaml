<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Fonts.xaml" />
        <ResourceDictionary Source="LedBaseStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="LedRedStepButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOffBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource LedRedBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.4"/>
                        <Border x:Name="Glow" Margin="0" CornerRadius="9" Background="{StaticResource LedRedBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource LedRed}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0"/>
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  RecognizesAccessKey="True" SnapsToDevicePixels="True">
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14"/>
                            <Setter TargetName="Glow" Property="Background" Value="White" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.25" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter Property="Foreground" Value="#FFFF3333"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedRed}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}">
                            <Setter Property="Foreground" Value="#FFFF3333"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedRed}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Background" Value="{StaticResource LedRedBrush}"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedRed}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Background" Value="{StaticResource LedRedBrush}"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedRed}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
