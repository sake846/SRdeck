<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 1. Basic Colors -->

    <Color x:Key="PanelBase">#FF121212</Color>
    <Color x:Key="PanelSurface">#FF1E1E1E</Color>
    <Color x:Key="ControlBase">#FF2A2A2A</Color>
    <Color x:Key="ControlBorder">#FF888888</Color>
    <Color x:Key="InstrumentBase">#FF2B2B2B</Color>
    <Color x:Key="RaisedPanel">#FF343434</Color>
    <!-- Dark-theme text hierarchy. Keep normal text bright; reserve dim colors for
         secondary information and disabled controls only. -->
    <Color x:Key="TextPrimary">#FFF2F2F2</Color>
    <Color x:Key="TextSecondary">#FFD6D6D6</Color>
    <Color x:Key="TextDim">#FFB8B8B8</Color>
    <Color x:Key="TextDisabled">#FF969696</Color>
    <Color x:Key="TextOnAccent">#FF111111</Color>
    <Color x:Key="BgDark">#FF363636</Color>
    <Color x:Key="BgPopup">#FF303030</Color>
    <Color x:Key="BgSelectedDark">#FF4A3C0B</Color>
    <Color x:Key="BrandTitleClose">#FFE81123</Color>
    <Color x:Key="BrandTitleClosePressed">#FF991924</Color>

    <!-- LED Colors -->
    <Color x:Key="LedBlue">#FF00E5FF</Color>
    <Color x:Key="LedRed">#FFFF0000</Color>
    <Color x:Key="LedYellowGreen">#FFB4E632</Color>
</ResourceDictionary>
