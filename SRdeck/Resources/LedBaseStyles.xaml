<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <sys:Double x:Key="ButtonTrenchOpacity">0.4</sys:Double>

    <Style x:Key="LedPlasticButtonStyleBase" TargetType="Button">
        <Setter Property="Background" Value="#1AFFFFFF"/>
        <Setter Property="Foreground" Value="{StaticResource TextOffBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <!-- Layer 0: Trench -->
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="{DynamicResource ButtonTrenchOpacity}"/>
                        
                        <!-- Layer 1: Outer Glow -->
                        <Border x:Name="Glow" Margin="-4" CornerRadius="9" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" 
                                                  BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>

                        <!-- Layer 2: Main Acrylic Body -->
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True">
                            <Border.Background>
                                <SolidColorBrush Color="#1AFFFFFF" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0"/>
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            
                            <Grid>
                                <!-- Layer 3: Internal LED Light -->
                                <Border x:Name="LedInternal" Opacity="0" CornerRadius="9">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.9">
                                            <GradientStop Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="0"/>
                                            <GradientStop Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}" Offset="0.15"/>
                                            <GradientStop Color="Transparent" Offset="0.9"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Layer 4: Surface Gloss -->
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="10" Margin="1,1,1,0" Opacity="0.1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  RecognizesAccessKey="True" SnapsToDevicePixels="True">
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.45"/>
                            <Setter TargetName="Body" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#45FFFFFF" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Body" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#33FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.3"/>
                            <Setter TargetName="LedInternal" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Body" Property="Background">
                                <Setter.Value>
                                    <RadialGradientBrush RadiusX="1" RadiusY="1">
                                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                                        <GradientStop Color="#1AFFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.3"/>
                            <Setter TargetName="LedInternal" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Body" Property="Background">
                                <Setter.Value>
                                    <RadialGradientBrush RadiusX="1" RadiusY="1">
                                        <GradientStop Color="#20FFFFFF" Offset="0"/>
                                        <GradientStop Color="#1AFFFFFF" Offset="1"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedYellowGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource LedPlasticButtonStyleBase}">
        <Setter Property="BorderBrush" Value="{StaticResource LedYellowGreenBrush}"/>
    </Style>

</ResourceDictionary>
