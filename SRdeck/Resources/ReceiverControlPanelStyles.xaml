<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:SRdeck.Converters">

    <conv:EqualityConverter x:Key="EqualityConverter" />
    <conv:ValueToBoolConverter x:Key="ValueToBoolConverter" />

    <!-- DELAY Button Style -->
    <Style x:Key="DelayButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LcdBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="#FF444444"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="0">
                        <Grid>
                            <TextBlock Text="遅延" FontSize="10" FontFamily="{StaticResource MainFontFamily}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="sec" FontSize="10" FontFamily="{StaticResource MainFontFamily}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,4" Foreground="{StaticResource TextSecondaryBrush}"/>
                            
                            <TextBlock x:Name="NumDisplay" Text="{Binding Tuner.HistorySec}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0" FontFamily="{StaticResource DisplayFontFamily}" FontSize="12" Foreground="{StaticResource LcdTextActiveBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDelayActive}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Rectangle Fill="{StaticResource DotMatrixBrush}" IsHitTestVisible="False" Opacity="0.1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#FF888888"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Acrylic RX Power Button Style -->
    <Style x:Key="LedRxPowerAcrylicButtonStyle" TargetType="Button" BasedOn="{StaticResource LedPlasticButtonStyleBase}">
        <Setter Property="BorderBrush" Value="{StaticResource LedBlueBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
                        <Border x:Name="Glow" Margin="-10" CornerRadius="10" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FDFF" BlurRadius="50" ShadowDepth="0" Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="#E6333333">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="2" Opacity="0.5" Direction="270"/>
                            </Border.Effect>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#A0FFFFFF" Offset="0"/>
                                    <GradientStop Color="#25FFFFFF" Offset="0.05"/>
                                    <GradientStop Color="#20FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#30FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="LedCenter" Opacity="0" CornerRadius="5" VerticalAlignment="Bottom" Margin="0,0,0,2" Height="6" Width="18">
                                    <Border.Background>
                                        <RadialGradientBrush RadiusX="1.2" RadiusY="1.0">
                                            <GradientStop Color="#00FDFF" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <BlurEffect Radius="10"/>
                                    </Border.Effect>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True" Margin="0,0,0,2">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="1" Opacity="0.9"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#FF444444" />
                            <Setter TargetName="Body" Property="BorderBrush" Value="#C0FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="0.3"/>
                            <Setter TargetName="LedCenter" Property="Opacity" Value="0.8"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="Body" Property="Background">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.5,0.8" GradientOrigin="0.5,0.8" RadiusX="0.45" RadiusY="1.4">
                                        <GradientStop Color="#2000FDFF" Offset="0"/>
                                        <GradientStop Color="#E6333333" Offset="1"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding ReceiverIndex}" Value="2" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF3333" BlurRadius="50" ShadowDepth="0" Opacity="0.7"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="LedCenter" Property="Background">
                                <Setter.Value>
                                    <RadialGradientBrush RadiusX="1.2" RadiusY="1.0">
                                        <GradientStop Color="#FF3333" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="1"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Body" Property="Background">
                                <Setter.Value>
                                    <RadialGradientBrush Center="0.5,0.8" GradientOrigin="0.5,0.8" RadiusX="0.45" RadiusY="1.4">
                                        <GradientStop Color="#25FF3333" Offset="0"/>
                                        <GradientStop Color="#E6333333" Offset="1"/>
                                    </RadialGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Speaker Button Style -->
    <Style x:Key="LedStereoSpeakerDynamicStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource InstrumentBaseBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOffBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource LedYellowGreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.22"/>
                        <Border x:Name="Glow" Margin="0" CornerRadius="9" Background="{StaticResource LedYellowGreenBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0"/>
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True"/>
                                <Border x:Name="LedLeft" HorizontalAlignment="Left" VerticalAlignment="Center" Width="3" Height="3" CornerRadius="1.5" Margin="6,0,0,0" Background="#8000E5FF" Opacity="0.3">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="LedRight" HorizontalAlignment="Right" VerticalAlignment="Center" Width="3" Height="3" CornerRadius="1.5" Margin="0,0,6,0" Background="#80FF3366" Opacity="0.3">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF3366" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14"/>
                            <Setter TargetName="Glow" Property="Background" Value="White" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.4" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ReceiverIndex}" Value="1" />
                                <Condition Binding="{Binding Tuner.IsSpeakerOn}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LedLeft" Property="Opacity" Value="1.0" />
                            <Setter TargetName="LedLeft" Property="Background" Value="#FF00E5FF" />
                            <Setter Property="Foreground" Value="#FF99CC00"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ReceiverIndex}" Value="1" />
                                <Condition Binding="{Binding Tuner.IsSpeakerOn}" Value="True" />
                                <Condition Binding="{Binding Tuner.IsOtherSpeakerOn}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LedRight" Property="Opacity" Value="1.0" />
                            <Setter TargetName="LedRight" Property="Background" Value="#FFFF3366" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ReceiverIndex}" Value="1" />
                                <Condition Binding="{Binding Tuner.IsSpeakerOn}" Value="True" />
                                <Condition Binding="{Binding Tuner.IsOtherReceiverVisible}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LedRight" Property="Opacity" Value="1.0" />
                            <Setter TargetName="LedRight" Property="Background" Value="#FFFF3366" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ReceiverIndex}" Value="2" />
                                <Condition Binding="{Binding Tuner.IsSpeakerOn}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LedRight" Property="Opacity" Value="1.0" />
                            <Setter TargetName="LedRight" Property="Background" Value="#FFFF3366" />
                            <Setter Property="Foreground" Value="#FF99CC00"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding ReceiverIndex}" Value="2" />
                                <Condition Binding="{Binding Tuner.IsSpeakerOn}" Value="True" />
                                <Condition Binding="{Binding Tuner.IsOtherSpeakerOn}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LedLeft" Property="Opacity" Value="1.0" />
                            <Setter TargetName="LedLeft" Property="Background" Value="#FF00E5FF" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.Tuner.IsOtherReceiverVisible}" Value="False" />
                                <Condition Binding="{Binding Tuner.IsSpeakerOn}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="LedLeft" Property="Opacity" Value="1.0" />
                            <Setter TargetName="LedLeft" Property="Background" Value="#FF00E5FF" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
