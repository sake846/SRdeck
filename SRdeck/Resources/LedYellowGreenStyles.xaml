<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Fonts.xaml" />
        <ResourceDictionary Source="LedBaseStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="LedYellowGreenStepButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOffBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource LedYellowGreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.4"/>
                        <!-- Active LED light occupies the original outer recess without changing the off-state cap. -->
                        <Border x:Name="ActiveGrooveGlow" Margin="-1" CornerRadius="10" Background="{StaticResource LedYellowGreenBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="5" ShadowDepth="0" Opacity="0.65"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="HoverGrooveGlow" Margin="-1" CornerRadius="10" Background="White" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0"/>
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Grid>
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  RecognizesAccessKey="True" SnapsToDevicePixels="True">
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14"/>
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0.32" />
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter Property="Foreground" Value="#FF99CC00"/>
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.42"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}">
                            <Setter Property="Foreground" Value="#FF99CC00"/>
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.42"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.62" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="6" ShadowDepth="0" Opacity="0.75"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HoverGrooveGlow" Property="Opacity" Value="0" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Opacity" Value="0.62" />
                            <Setter TargetName="ActiveGrooveGlow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="6" ShadowDepth="0" Opacity="0.75"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedStepButtonStyle" TargetType="Button" BasedOn="{StaticResource LedYellowGreenStepButtonStyle}"/>

