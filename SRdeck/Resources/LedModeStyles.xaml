<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Brushes.xaml" />
        <ResourceDictionary Source="Fonts.xaml" />
        <ResourceDictionary Source="LedBaseStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="LedModeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource InstrumentBaseBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOffBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource LedYellowGreenBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <!-- Layer 0: Trench -->
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.22"/>

                        <!-- Layer 1: Outer Glow (隙間の光漏れ) -->
                        <Border x:Name="Glow" Margin="0" CornerRadius="9" Background="{StaticResource LedYellowGreenBrush}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>

                        <!-- Layer 2: Main Acrylic Body -->
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0"/>
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            
                            <Grid>
                                <!-- Layer 4: Surface Gloss -->
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  RecognizesAccessKey="True" SnapsToDevicePixels="True">
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14"/>
                            <Setter TargetName="Glow" Property="Background" Value="White" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.25" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter Property="Foreground" Value="#FF99CC00"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}">
                            <Setter Property="Foreground" Value="#FF99CC00"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Background" Value="{StaticResource LedYellowGreenBrush}"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="{x:Static sys:Boolean.TrueString}" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Background" Value="{StaticResource LedYellowGreenBrush}"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource LedYellowGreen}" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedRxPowerModeButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource InstrumentBaseBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextOffBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MainFontFamily}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderBrush" Value="{StaticResource LedBlueBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <!-- Layer 0: Trench -->
                        <Border Margin="-1" CornerRadius="10" Background="#FF000000" Opacity="0.22"/>

                        <!-- Layer 1: Outer Glow (隙間の光漏れ) -->
                        <Border x:Name="Glow" Margin="0" CornerRadius="9" Background="#FF00E5FF" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                        </Border>

                        <!-- Layer 2: Main Acrylic Body -->
                        <Border x:Name="Body" CornerRadius="9" BorderThickness="1" SnapsToDevicePixels="True" Background="{TemplateBinding Background}">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1EFFFFFF" Offset="0"/>
                                    <GradientStop Color="#0FFFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            
                            <Grid>
                                <!-- Layer 4: Surface Gloss -->
                                <Border x:Name="Gloss" CornerRadius="9" VerticalAlignment="Top" Height="8" Margin="1,1,1,0" Opacity="0.08">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                  RecognizesAccessKey="True" SnapsToDevicePixels="True">
                                </ContentPresenter>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.14"/>
                            <Setter TargetName="Glow" Property="Background" Value="White" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.25" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- Cyan (Rx1) Tag=True -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                            <Setter Property="Foreground" Value="#FF00E5FF"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF00E5FF" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- Pink (Rx2) Tag=True and ReceiverIndex=2 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding ReceiverIndex}" Value="2" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="#FFFF99CC"/>
                            <Setter TargetName="Glow" Property="Background" Value="#FFFF99CC"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.2"/>
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FFFF99CC" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Content" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FFFF99CC" BlurRadius="12" ShadowDepth="0" Opacity="1.0"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <!-- Add on-state hover effect for Rx1 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Background" Value="#FF00E5FF"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF00E5FF" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                        <!-- Add on-state hover effect for Rx2 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                                <Condition Binding="{Binding ReceiverIndex}" Value="2" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Background" Value="#FFFF99CC"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.5" />
                            <Setter TargetName="Glow" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FFFF99CC" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LedSqModeButtonStyle" TargetType="Button" BasedOn="{StaticResource LedModeButtonStyle}">
    </Style>
    <Style x:Key="LedStereoSpeakerModeButtonStyle" TargetType="Button" BasedOn="{StaticResource LedModeButtonStyle}">
    </Style>

    <!-- Transparent Overlay Buttons -->
    <Style x:Key="TransparentOverlayButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{StaticResource BorderActiveBrush}" CornerRadius="0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource OverlayHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
