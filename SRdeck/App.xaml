<Application x:Class="SRdeck.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:SRdeck"
             xmlns:conv="clr-namespace:SRdeck.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Colors.xaml" />
                <ResourceDictionary Source="/Resources/Brushes.xaml" />
                <ResourceDictionary Source="/Resources/Fonts.xaml" />
                <ResourceDictionary Source="/Resources/Converters.xaml" />
                <ResourceDictionary Source="/Resources/ControlStyles.xaml" />
                <ResourceDictionary Source="/Resources/SettingsDialogStyles.xaml" />
                <ResourceDictionary Source="/Resources/ComplexStyles.xaml" />
                <ResourceDictionary Source="/Resources/TitleBarStyles.xaml" />
                <ResourceDictionary Source="/Resources/LedStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SRdeckPlugin.Wpf;component/Themes/PluginTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SRdeckPlugin.Wpf;component/Themes/PluginControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
